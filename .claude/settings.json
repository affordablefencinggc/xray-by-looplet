{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guardrails/hook.mjs\" session-start", "timeout": 10, "statusMessage": "Loading X-Ray guardrails" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guardrails/hook.mjs\" pre-tool", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guardrails/hook.mjs\" stop", "timeout": 10 }
        ]
      }
    ]
  }
}
