# Dependencies
node_modules/
.node_modules.lock

# Rust / Tauri build output — this is the bulk of the workspace export
# (~1000 files) and is regenerated by `cargo build`. Never commit it.
src-tauri/target/

# Build output
dist/
build/
.vercel/
.tanstack/

# Environment and local config
.env
.env.*
!.env.example

# Logs and caches
*.log
npm-debug.log*
.cache/
.temp/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Python & Spec
__pycache__/
*.py[cod]
*.spec

# Rust build target
engine/host/target/
src-tauri/bin/
screenshots/

# Local generated audit/runtime state (source and evidence remain trackable)
.pytest_cache/
proof/audit/IW005/legacy-browser/
proof/audit/**/python-deps/
proof/audit/**/mcp-deps/
engine/bin/*.exe
.autopilot/sweeper-report.json

# Preserve authoritative execution logs and actual industry proof screenshots.
!proof/audit/**/*.log
!screenshots/
screenshots/*
!screenshots/industry-*/
