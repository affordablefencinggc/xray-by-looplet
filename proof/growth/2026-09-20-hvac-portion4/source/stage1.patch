+          {numeric("nodes", i, "x", "X (m)", node.x)}{numeric("nodes", i, "y", "Elevation (m)", node.y)}{numeric("nodes", i, "z", "Z (m)", node.z)}{numeric("nodes", i, "designAirflowLs", "Design airflow (L/s)", node.designAirflowLs)}
