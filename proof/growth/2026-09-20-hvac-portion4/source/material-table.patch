+++ b/src/studio/industries/hvac/ductMaterialTable.test.ts
@@ -0,0 +1,17 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { ductMaterialTableSchema, emptyDuctMaterialRow, evaluateDuctMaterialRow, reviewDuctMaterialRow, type DuctMaterialRow } from "./ductMaterialTable.ts";
+import { calculateDuctForm, createEmptyDuctSection, ductFormSchema } from "./ductForm.ts";
+const fixture = (): DuctMaterialRow => ({ ...emptyDuctMaterialRow("material-1"), material: "galvanized-steel", gauge: "Supplier G1", thickness: "0.5", density: "8000", reference: "Synthetic supplier table", sourceId: "table-1", sourceRevision: "A", sourceSha256: "a".repeat(64), reviewer: "Test reviewer" });
+const reviewed = () => reviewDuctMaterialRow(fixture(), "2026-09-20T12:00:00Z");
+const form = (rows = [reviewed()]) => ({ materialRows: rows, sections: [{ ...createEmptyDuctSection(), id: "D1", lengthM: { value: "10", sourceReference: "Synthetic" }, widthM: { value: ".5", sourceReference: "Synthetic" }, heightM: { value: ".3", sourceReference: "Synthetic" }, includeSheetMass: true, materialRowId: "material-1", sheetMassKgPerM2: { value: "999", sourceReference: "Must not be used as fallback" } }] });
+test("material rows start unknown without invented gauge, thickness or density", () => { const r = emptyDuctMaterialRow("empty"); assert.equal(r.material, ""); assert.equal(r.thickness, ""); assert.equal(r.density, ""); assert.equal(evaluateDuctMaterialRow(r).status, "unknown"); assert.throws(() => reviewDuctMaterialRow(r)); });
+test("complete unreviewed row cannot supply mass", () => { assert.equal(evaluateDuctMaterialRow(fixture()).status, "unknown"); assert.equal(calculateDuctForm(form([fixture()])).sheetMassKg, null); });
+test("explicit review links material operands to section mass and survives JSON persistence", () => { const input = form(); const saved = ductFormSchema.parse(JSON.parse(JSON.stringify(input))); const r = calculateDuctForm(saved); assert.equal(r.sheetMassKg, 64); assert.match(r.sections[0].inputs.sheetMassKgPerM2!.sourceReference, /Supplier G1/); assert.equal(r.verifiedQuoteEligible, false); });
+test("every engineering or source edit invalidates reviewed material mass", () => { for (const patch of [{ material: "aluminum" }, { gauge: "G2" }, { thickness: "0.6" }, { thicknessUnit: "m" }, { density: "7900" }, { sourceRevision: "B" }, { sourceId: "other" }, { sourceSha256: "b".repeat(64) }, { reference: "Different table" }]) { const row = { ...reviewed(), ...patch }; assert.equal(evaluateDuctMaterialRow(row).status, "unknown"); assert.equal(calculateDuctForm(form([row as DuctMaterialRow])).sheetMassKg, null); } });
+test("re-review restores mass for edited values; switching units preserves physical value", () => { const row = reviewDuctMaterialRow({ ...reviewed(), thickness: ".0005", thicknessUnit: "m" }); assert.equal(calculateDuctForm(form([row])).sheetMassKg, 64); const edited = reviewDuctMaterialRow({ ...row, density: "7000" }); assert.equal(calculateDuctForm(form([edited])).sheetMassKg, 56); });
+test("deleted and missing material rows withhold mass instead of using stale direct input", () => { assert.equal(calculateDuctForm(form([])).sheetMassKg, null); const n = form(); n.sections[0].materialRowId = "missing"; assert.equal(calculateDuctForm(n).sheetMassKg, null); });
+test("sample and inferred material rows cannot be reviewed or reused as known mass", () => { for (const evidence of ["sample", "inferred"] as const) { const row = { ...reviewed(), evidence }; assert.throws(() => reviewDuctMaterialRow(row)); assert.equal(evaluateDuctMaterialRow(row).status, "unknown"); assert.equal(calculateDuctForm(form([row])).sheetMassKg, null); } });
+test("all supported materials require their supplied thickness and density", () => { for (const material of ["galvanized-steel", "aluminum", "stainless-steel"] as const) { const row = reviewDuctMaterialRow({ ...fixture(), material }); assert.equal(evaluateDuctMaterialRow(row).sheetMassKgPerM2?.value, 4); } });
+test("invalid numbers and absent gauge/source/reviewer are refused", () => { for (const patch of [{ thickness: "0x10" }, { thickness: "-1" }, { thickness: "Infinity" }, { density: "1e999" }, { gauge: "" }, { sourceSha256: "short" }, { reviewer: "" }]) assert.throws(() => reviewDuctMaterialRow({ ...fixture(), ...patch })); });
+test("duplicate table identity is rejected, explicit direct mode remains compatible", () => { assert.throws(() => ductMaterialTableSchema.parse([reviewed(), reviewed()])); const input = form(); input.sections[0].materialRowId = ""; assert.equal(calculateDuctForm(input).sheetMassKg, 15984); input.sections[0].includeSheetMass = false; assert.equal(calculateDuctForm(input).sheetMassKg, null); });
diff --git a/src/studio/industries/hvac/DuctMaterialTable.tsx b/src/studio/industries/hvac/DuctMaterialTable.tsx
