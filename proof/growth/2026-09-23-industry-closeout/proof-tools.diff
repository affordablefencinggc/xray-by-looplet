+const result=spawnSync('tar',['-cf',file,'-T','proof/growth/2026-09-23-industry-closeout/transfer/native-files.txt'],{stdio:'inherit',windowsHide:true});if(result.status!==0)throw Error('Native archive failed');
+for(const e of entries)if(hash(e.path)!==e.sha256)throw Error('Native source changed during transfer');
+const manifest={createdAt:new Date().toISOString(),archiveSha256:hash(file),entries};
+fs.writeFileSync('proof/growth/2026-09-23-industry-closeout/transfer/native-manifest.json',JSON.stringify(manifest,null,2));
