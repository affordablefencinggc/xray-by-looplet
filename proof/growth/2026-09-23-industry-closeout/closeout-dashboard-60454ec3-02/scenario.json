    "(()=>{const values=[...document.querySelectorAll('.kpi-card')].map(e=>e.innerText);if(document.documentElement.scrollWidth>innerWidth+1)throw Error('Page overflow');return {kpis:values}})()"
  ],
  [
    "screenshot",
    "captures/dashboard-18-of-20.png"
  ],
  [
    "errors"
  ]
]
