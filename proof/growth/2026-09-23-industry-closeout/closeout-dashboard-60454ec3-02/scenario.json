[
  [
    "set",
    "viewport",
    "1600",
    "1000"
  ],
  [
    "open",
    "{{ORIGIN}}/v1-dashboard-60454ec3.html"
  ],
  [
    "wait",
    "--fn",
    "document.body?.textContent.includes('18 / 20 DONE')&&document.body?.textContent.includes('18 Done, 0 Partial, 0 Blocked, 2 Pending')",
