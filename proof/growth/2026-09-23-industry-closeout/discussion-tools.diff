+ ev(`(()=>{const error=document.querySelector('.assistant-chat-error');if(error)throw Error(error.textContent);if(document.querySelectorAll('.assistant-chat-entry.is-tool').length)throw Error('Discussion used a tool');const rows=[...document.querySelectorAll('.assistant-chat-entry.is-assistant')];const text=rows.at(-1).innerText;if(!/Developer review/i.test(text))throw Error('Developer review absent');if(localStorage.getItem('xray:fencing-job:v2')!==window.__sourceBefore||localStorage.getItem('xray.industry-drafts.v1:job-sc09-room-roof')!==window.__draftBefore)throw Error('Source data changed');const requests=window.__turnRequests.slice(window.__requestStart);if(requests.length<1||requests.length>3||requests.some(r=>r.declarations!==0)||requests.slice(1).some(r=>!r.developerReminder&&!r.claimCorrection)||requests.filter(r=>r.developerReminder).length>1||requests.filter(r=>r.claimCorrection).length>1)throw Error('Unexpected calls/declarations: '+JSON.stringify(requests));rows.at(-1).scrollIntoView({block:'start'});sessionStorage.setItem('explanation-replies',JSON.stringify(rows.map(r=>r.innerText)));return {reply:text,requests,sourceUnchanged:true}})()`);
