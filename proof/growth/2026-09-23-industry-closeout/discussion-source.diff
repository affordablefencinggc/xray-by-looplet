@@ -0,0 +1,8 @@
+/** Worksheet semantics also accompany discussion turns, which have no tool declarations. */
+export function worksheetExplanationGuidance(objective: string): string {
+  const rules: string[] = [];
+  if (/\b(?:roof|roofing|courses?|end lap)\b/i.test(objective)) rules.push('Roofing worksheet explanation rules: For a rectangular developed plane with width W, run R, effective cover C, identical ordered sheet length L and end lap E (0 <= E < L), columns = ceil(W/C). The first course covers the full L; each further course adds L-E. Courses = 1 when 0 < R <= L, otherwise 1 + ceil((R-L)/(L-E)). Do not use ceil(R/(L-E)): it deducts a nonexistent lap from the first course. At an exact coverage boundary keep the lower course count; immediately above it another course is needed. Sheets = columns * courses; ordered linear metres = sheets * L. Effective cover already includes side lap. This arithmetic is a worksheet convention, not installation advice or product suitability approval. Apply the same arithmetic in Developer review.');
+  if (/\b(?:QS|quantity|hierarchy|hierarchical|SUMMARY_NODE|LEAF_ITEM|unassigned)\b/i.test(objective)) rules.push('QS worksheet explanation rules: Whole-draft totals include unassigned items; a classification subtree includes only items assigned directly to that node or its descendants. An unassigned item never enters a parent rollup. Keep each (unit, evidence class) subtotal separate; do not combine inferred and unverified quantities into a single purported evidence subtotal. Inclusive parent and child totals overlap. Flat item CSVs contain item rows only; hierarchical CSVs distinguish SUMMARY_NODE from LEAF_ITEM. Sum each leaf once within its unit and evidence class, never add summary rows. These rules also apply to every numerical example in Developer review. Review examples must not change the supplied assignments, units or evidence classes. A leading apostrophe neutralizes formula-like exported text; how it is displayed depends on the importing spreadsheet.');
+  if (rules.length) rules.push('All supplied worksheet examples remain draft and verifiedQuoteEligible=false. For QS, never display a combined amount across evidence classes, even as an intermediate parent total followed by a caveat. Express every whole or node rollup as separate labelled unit/evidence subtotals. The words "kept separate" do not make a combined amount valid.');
+  return rules.length ? '\n\n' + rules.join('\n\n') : '';
+}
