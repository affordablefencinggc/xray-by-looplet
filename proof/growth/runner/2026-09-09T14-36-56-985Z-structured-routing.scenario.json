[["eval","(async()=>{const {useStudio}=await import('/src/studio/store.ts');const {loadArchitect}=await import('/src/studio/architect/persistence.ts');const {listWorkPackets,readWorkEvents,verifyWorkJournal}=await import('/src/studio/assistant/workPacketStore.ts');const id=useStudio.getState().job.id,packets=await listWorkPackets(id),events=await Promise.all(packets.map(p=>readWorkEvents(p.id)));return {projectId:id,design:loadArchitect(id,localStorage).value,packets,events,journals:await Promise.all(packets.map((p,i)=>verifyWorkJournal(p,events[i]))),panel:document.querySelector('[aria-label=\"Drawing assistant panel\"]')?.innerText}})()"]]