[["eval","(async()=>{const {useStudio}=await import('/src/studio/store.ts');const {listWorkPackets,readWorkEvents}=await import('/src/studio/assistant/workPacketStore.ts');const p=(await listWorkPackets(useStudio.getState().job.id))[0];const e=p?await readWorkEvents(p.id):[];return {packet:p?.state,tools:e.filter(x=>x.kind==='tool-result').map(x=>({tool:x.payload.tool,error:x.payload.result.isError,text:x.payload.result.content.filter(p=>p.type==='text').map(p=>p.text.slice(0,1500))})),conversation:document.querySelector('[aria-label=\"Assistant conversation\"]')?.innerText}})()"],["screenshot","screenshots/large-files-gemini.png"],["errors"]]