[["eval","(async()=>{const ls=Object.keys(localStorage).map(k=>[k,localStorage.getItem(k).length]);const ss=Object.keys(sessionStorage);let dbs=null;try{dbs=(await indexedDB.databases()).map(d=>d.name+':'+d.version)}catch(e){dbs='err '+e}const job=JSON.parse(localStorage.getItem('xray:fencing-job:v2')||'null');return {ls,ss,dbs,job:job&&{id:job.id,name:job.name,revision:job.revision,docs:(job.documents||[]).map(d=>({id:d.id,name:d.name,source:d.source,pages:d.pageCount})),calibrations:(job.calibrations||[]).length,annotations:(job.annotations||[]).length,trades:(job.trades||[]).length},tauri:!!window.__TAURI_INTERNALS__}})()"]]