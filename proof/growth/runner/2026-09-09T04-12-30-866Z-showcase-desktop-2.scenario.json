[["eval","(()=>({busy:!!document.querySelector('[aria-label=\"Stop assistant response\"]'),entries:document.querySelectorAll('.assistant-chat-entry').length,replies:document.querySelectorAll('.assistant-chat-entry.is-assistant').length,errors:[...document.querySelectorAll('.assistant-chat-error')].map(e=>e.textContent.slice(0,120)),receipts:[...document.querySelectorAll('.assistant-chat-entry.is-tool')].filter(e=>/Tool result|Action failed/.test(e.textContent)).map(e=>e.textContent.trim().slice(0,60)),last:([...document.querySelectorAll('.assistant-chat-entry.is-assistant')].at(-1)?.textContent||'').slice(0,400),design:(()=>{const w=document.querySelector('.architect-workspace');if(!w)return {mounted:false};const raw=localStorage.getItem('xray:architect:v1:'+encodeURIComponent(w.dataset.designId));if(!raw)return {mounted:true,saved:false};const d=JSON.parse(raw);return {name:d.name,revision:d.revision,levels:d.levels.map(l=>l.name+'@'+l.elevation),walls:d.walls.length,doors:d.openings.filter(o=>o.kind==='door').length,windows:d.openings.filter(o=>o.kind==='window').length,rooms:d.roomTags.map(r=>r.name),slabs:d.slabs.length,roofs:d.roofs.length}})()}))()"]]