[["set","viewport","1600","1000"],["open","http://127.0.0.1:8085/"],["wait","--fn","!!document.querySelector('.assistant-conversation')","--timeout","120000"],["eval","(()=>{const log=document.querySelector('.assistant-conversation');const all=[...log.querySelectorAll('*')].filter(e=>e.children.length===0&&e.textContent.trim());const classes=[...new Set([...log.querySelectorAll('[class]')].map(e=>e.className))].slice(0,20);return JSON.stringify({logClass:log.className,childClasses:classes,lastTexts:all.slice(-8).map(e=>e.textContent.trim().slice(0,80))})})()"]]