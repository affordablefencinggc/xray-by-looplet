[["eval","(async()=>{const {useStudio}=await import('/src/studio/store.ts');const {listWorkPackets,readWorkEvents}=await import('/src/studio/assistant/workPacketStore.ts');const ps=await listWorkPackets(useStudio.getState().job.id);return await Promise.all(ps.map(async p=>({id:p.id,state:p.state,next:p.nextAction,pending:p.pendingAction,events:(await readWorkEvents(p.id)).slice(-6).map(e=>({at:e.at,kind:e.kind,tool:e.payload?.tool,parts:e.kind==='model-response-unreviewed'?e.payload.content.parts.map(p=>({text:p.text,tool:p.functionCall?.name})):undefined}))})));})()"]]