    "--fn",
    "(()=>{var root=document.querySelector('.measure-document-preview'),view=document.querySelector('.sheet-bookmarks');if(root?.dataset.sourceReady!=='true'||!view?.dataset.restoredView)return false;var record=Object.keys(localStorage).filter(k=>k.startsWith('xray.sheet-lifecycle.v1:')).map(k=>JSON.parse(localStorage.getItem(k))).find(v=>v.pages.some(p=>p.bookmarks?.some(b=>b.name==='Drainage junction'))),b=record?.pages.flatMap(p=>p.bookmarks??[]).find(b=>b.name==='Drainage junction'),v=root.querySelector('.document-preview-viewport').getBoundingClientRect(),p=root.querySelector('.document-source-page')?.getBoundingClientRect();return !!b&&!!p&&Math.abs((v.left+v.width/2-p.left)/p.width-b.center.x)<.002&&Math.abs((v.top+v.height/2-p.top)/p.height-b.center.y)<.002})()"
