+        }
+      }
+    }
+    return false;
+  }
+  function eligible(door: Door) {
+    if (!door.originals.some(({ mesh }) => visible(mesh))) return null;
+    cameraPosition(); camera.getWorldDirection(facing);
+    if (eye.y < door.bounds.min.y - 0.1 || eye.y > door.bounds.max.y + 0.35) return null;
