+.qs-cost-table [data-change="removed"] .qs-cost-change { color: var(--qs-negative); background: var(--qs-negative-surface); }
+.qs-cost-table [data-change="modified"] .qs-cost-change { color: var(--qs-change); background: var(--qs-change-surface); }
+.qs-cost-change { display: inline-block; padding: 3px 7px; border: 1px solid currentColor; border-radius: var(--radius-pill); white-space: nowrap; font-weight: 600; }
