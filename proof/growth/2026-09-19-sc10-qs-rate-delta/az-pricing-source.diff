+.qs-cost-actions { display: flex; flex-wrap: wrap; gap: 10px; }
+.qs-cost-comparison { margin: auto 0 auto auto; width: min(1180px, 96vw); max-width: 96vw; max-height: 94vh; padding: 24px; border: 1px solid var(--color-line); border-radius: var(--radius-panel) 0 0 var(--radius-panel); background: var(--color-card); overflow: auto; }
+.qs-cost-comparison[open] { display: grid; gap: 20px; }
+.qs-cost-comparison::backdrop { background: rgb(0 0 0 / 55%); }
+.qs-cost-delta-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 12px; }
