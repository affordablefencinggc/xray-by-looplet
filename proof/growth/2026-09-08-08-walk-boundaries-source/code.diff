+    return null;
+  }
+  function insideSolid(feet: THREE.Vector3) {
+    const point = feet.clone().add(new THREE.Vector3(0, HEIGHT / 2, 0));
+    const ray = new THREE.Ray(point, new THREE.Vector3(1, .017, .031).normalize()), target = new THREE.Vector3();
