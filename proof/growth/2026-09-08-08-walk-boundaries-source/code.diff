+    walkWorld: () => ({
+      validStart: () => true,
+      move(feet, displacement) {
+        moves++;
+        return { position: feet.clone().add(displacement), blocked: false };
+      },
+    }),
+  });
+  await f.api.start("walk", start);
+  f.event(f.doc, "keydown", { code: "KeyW" });
