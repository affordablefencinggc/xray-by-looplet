.workflow-nav, .workflow-context { display: flex; align-items: center; gap: 8px; min-height: 44px; height: 100%; padding: 0 16px; }
.workflow-nav button, .workflow-context button { flex-shrink: 0; min-height: 40px; padding: 8px 16px; color: var(--color-muted); background: transparent; border: 0; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; }
.workflow-nav button:hover, .workflow-context button:hover { background: var(--color-selected); color: var(--color-ink); }
.workflow-nav button[aria-current] { color: var(--color-ink); box-shadow: inset 0 -2px var(--color-accent, var(--color-ink)); background: var(--color-selected); }
.workflow-nav .workflow-checks { margin-left: auto; border-left: 1px solid var(--color-line); }
.workflow-context { gap: 8px; }
.workflow-context-label { font-size: 11px; color: var(--color-muted); padding-right: 12px; border-right: 1px solid var(--color-line); }
.workflow-context button { font-size: 12px; padding: 6px 12px; min-height: 36px; border-radius: 5px; }
.workflow-context button[aria-current] { background: var(--color-card); color: var(--color-ink); box-shadow: inset 0 0 0 1px var(--color-line); }
.workflow-context-hint { margin-left: auto; color: var(--color-muted); font-size: 11px; white-space: nowrap; }
.project-identity { display: flex; flex-direction: column; min-width: 0; gap: 2px; }
.project-identity button { color: var(--color-ink); font-size: 13px; font-weight: 600; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 260px; cursor: pointer; }
.project-identity small { color: var(--color-muted); font-size: 10px; }
.project-menu-trigger { display: inline-flex; align-items: center; gap: 8px; }
.workbench .workspace-dialog:has(.project-menu-content) { width: min(680px, calc(100vw - 48px)); }
.project-menu-content { display: grid; gap: 16px; padding: 24px; }
.project-menu-content .workspace-plan-switcher { max-width: none; }
.project-menu-content .workspace-plan-switcher label { flex-direction: column; align-items: stretch; }
.project-menu-content .workspace-plan-controls { flex-wrap: wrap; }
.project-menu-content .backup-trigger { justify-self: start; }
.drawing-sheet-manager > summary { color: var(--color-muted); font-size: 12px; cursor: pointer; padding: 8px 0; }
.workspace-rails[data-pane="sheets"] .workspace-central-content:has(.source-ingest) { justify-content: center; align-items: center; }
.workspace-rails[data-pane="sheets"] .source-ingest { width: min(100%, 680px); margin: 24px auto; min-height: 0; }
.workspace-rails .workspace-diagnostics[data-expanded="false"] .workspace-diagnostics-toggle { flex: 0 0 auto; justify-content: flex-start; width: auto; margin-left: 0; gap: 8px; padding-inline: 12px; }
.workspace-rails .workspace-diagnostics[data-expanded="true"] .workspace-diagnostics-toggle { width: auto; gap: 8px; padding-inline: 12px; }
.workspace-rails .workspace-diagnostics[data-expanded="false"] { height: var(--workspace-bottom-bar-height); min-height: var(--workspace-bottom-bar-height); }
.workspace-rails .workspace-diagnostics[data-expanded="false"] .workspace-diagnostics-bar,
.workspace-rails .workspace-diagnostics[data-expanded="false"] .workspace-diagnostics-bar button { height: calc(var(--workspace-bottom-bar-height) - 1px); min-height: calc(var(--workspace-bottom-bar-height) - 1px); }
@media (max-width: 1100px) { .workflow-context-hint { display: none; } .workbench .studio-brand > span:last-child { display: none; } }
@media (max-width: 700px) { .workflow-nav, .workflow-context { overflow-x: auto; padding-inline: 8px; } .workflow-nav button { padding-inline: 12px; } .project-identity button { max-width: 160px; } }

.workflow-nav { display: grid; grid-template-columns: minmax(80px, 1fr) auto minmax(80px, 1fr); gap: 0; }
.workflow-main-tabs { grid-column: 2; display: flex; align-items: center; gap: 8px; }
.workflow-nav .workflow-checks { grid-column: 3; justify-self: end; margin-left: 0; }
