[
  [
    "open",
    "http://127.0.0.1:8082/"
  ],
  [
    "set",
    "viewport",
    "1440",
    "900"
  ],
  [
    "wait",
    "--fn",
    "!!document.querySelector('.studio-header')"
  ],
  [
    "screenshot",
    "desktop-initial.png"
  ],
  [
    "eval",
    "JSON.stringify({text:document.body.innerText.slice(0,3000),launcher:document.querySelector('.live-assistant-launcher')?.getBoundingClientRect().toJSON(),aside:document.querySelector('.live-assistant')?.getBoundingClientRect().toJSON()})"
  ],
  [
    "eval",
    "document.querySelector('[aria-label=\"MCP connections\"]').click()"
  ],
  [
    "wait",
    "--fn",
    "!!document.querySelector('dialog[open]')"
  ],
  [
    "screenshot",
    "mcp.png"
  ],
  [
    "errors"
  ]
]
