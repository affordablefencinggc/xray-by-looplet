@@ -1100,3 +1100,93 @@
 .qs-measured-model { width: 100%; height: 176px; min-height: 176px; background: var(--color-paper); }
 .evidence-surface-label { display: block; padding: 6px 8px; color: var(--color-cbar); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
 .qs-binding-highlight { display: inline-flex; min-height: 44px; align-items: center; margin-top: 6px; border: 1px solid var(--color-line); border-radius: 999px; padding: 8px 12px; background: var(--color-paper); color: var(--color-ink); font: inherit; font-size: 12px; font-weight: 700; }
+
+/* QS evidence uses the active workbench palette. Containment belongs to the
+   report, not the whole estimate pane: only its explicit table wrappers scroll. */
+.qs-item-binding-ledger,
+.qs-quantity-report {
+  min-width: 0;
+  width: 100%;
+  max-width: 100%;
+  color: var(--color-ink);
+  overflow-wrap: anywhere;
+  container-type: inline-size;
+}
+.qs-item-binding-ledger { container-name: qs-ledger; }
+.qs-quantity-report { display: grid; gap: 12px; container-name: qs-report; }
+.industry-workbench:has(.qs-item-binding-ledger) .industry-workbench-body,
+.industry-draft-host:has(.qs-item-binding-ledger) { min-width: 0; }
+.qs-binding-heading { margin-bottom: .75rem; }
+.qs-binding-title { margin: 0; color: var(--color-ink); font-size: .9375rem; font-weight: 700; }
+.qs-item-binding-ledger .qs-binding-explanation { margin: .25rem 0; color: var(--color-muted); font-size: .8125rem; line-height: 1.5; }
+.qs-binding-withheld-notice { margin-bottom: 1rem; padding: .75rem 1rem; border: 1px solid var(--color-line); border-left: 4px solid var(--color-danger); border-radius: var(--radius-panel); background: var(--color-paper); color: var(--color-ink); }
+.qs-binding-withheld-notice strong { display: block; margin-bottom: .25rem; font-size: .875rem; }
+.qs-binding-withheld-notice p { margin: 0; font-size: .8125rem; line-height: 1.5; }
+.qs-binding-table-wrap { width: 100%; min-width: 0; margin-bottom: 1.25rem; }
+.qs-binding-table-wrap table { width: 100%; table-layout: fixed; }
+.qs-binding-table-wrap :is(th, td) { min-width: 0; white-space: normal; overflow-wrap: anywhere; }
+.qs-binding-table-wrap th:nth-child(1) { width: 15%; }
+.qs-binding-table-wrap th:nth-child(2) { width: 12%; }
+.qs-binding-table-wrap th:nth-child(3) { width: 31%; }
+.qs-binding-table-wrap th:nth-child(4) { width: 26%; }
+.qs-binding-table-wrap th:nth-child(5) { width: 16%; }
+.qs-binding-cell-label { display: none; }
+.qs-binding-reference { font-weight: 600; }
+.qs-binding-quantity { font-family: var(--font-mono); }
+.qs-binding-entity { font-size: .8125rem; }
+.qs-binding-entity > span:not(.qs-binding-cell-label) { display: block; }
+.qs-item-binding-ledger .qs-binding-provenance { min-width: 0; max-width: 100%; margin-top: 8px; }
+.qs-item-binding-ledger .qs-binding-provenance summary { min-width: 44px; min-height: 44px; padding-block: 12px; line-height: 20px; list-style-position: inside; cursor: pointer; overflow-wrap: anywhere; }
+.qs-item-binding-ledger .qs-binding-provenance summary:focus-visible { outline: 2px solid var(--color-action); outline-offset: 2px; }
+.qs-item-binding-ledger .qs-binding-provenance dl { display: grid; gap: 10px; min-width: 0; margin: 8px 0; }
+.qs-item-binding-ledger .qs-binding-provenance dl > div { min-width: 0; }
+.qs-item-binding-ledger .qs-binding-provenance dt { margin-bottom: 4px; color: var(--color-muted); font-size: .6875rem; }
+.qs-item-binding-ledger .qs-binding-provenance dd { min-width: 0; margin: 0; }
+.qs-item-binding-ledger .qs-binding-provenance code { display: block; max-width: 100%; color: var(--color-ink); font-family: var(--font-mono); font-size: .75rem; white-space: normal; overflow-wrap: anywhere; user-select: text; }
+.qs-item-binding-ledger .qs-binding-provenance p { margin: 8px 0; color: var(--color-muted); font-size: .75rem; line-height: 1.5; }
+.qs-binding-status-pill { display: inline-block; max-width: 100%; padding: .25rem .5rem; border: 1px solid var(--color-line); border-radius: var(--radius-pill); background: var(--color-paper); color: var(--color-ink); font-size: .75rem; font-weight: 700; }
+.qs-item-binding-ledger [data-binding-status="verified"] .qs-binding-status-pill { border-color: var(--color-action); }
+.qs-item-binding-ledger [data-binding-status="stale-measurement"] .qs-binding-status-pill { border-color: var(--color-danger); }
+.qs-item-binding-ledger :is([data-binding-status="unit-changed"], [data-binding-status="uncalibrated"], [data-binding-status="ineligible-evidence"]) .qs-binding-status-pill { border-color: var(--color-warn); }
+.qs-item-binding-ledger .qs-binding-reasons { margin: .375rem 0 0; padding-left: 1rem; color: var(--color-ink); font-size: .75rem; }
+.qs-binding-pricing > span:not(.qs-binding-cell-label) { color: var(--color-ink); font-size: .8125rem; font-weight: 700; }
+.qs-item-binding-ledger .qs-binding-highlight { max-width: 100%; min-width: 44px; white-space: normal; text-align: left; border-radius: var(--radius-pill); }
+
+/* The pane, rather than viewport width, determines when ledger rows become
+   labelled cards. Explicit table roles preserve the header/cell relationships. */
+@container qs-ledger (max-width: 740px) {
+  .qs-binding-table-wrap { overflow: visible; }
+  .qs-binding-table-wrap :is(table, caption, tbody) { display: block; width: 100%; }
+  .qs-binding-table-wrap thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+  .qs-binding-table-wrap tbody { display: grid; gap: 12px; }
+  .qs-binding-table-wrap tbody tr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border: 1px solid var(--color-line); border-radius: var(--radius-panel); background: var(--color-paper); }
+  .qs-binding-table-wrap tbody td { display: block; padding: 10px 12px; border-bottom: 0; }
+  .qs-binding-cell-label { display: block; margin-bottom: 4px; color: var(--color-muted); font-family: var(--font-sans); font-size: .6875rem; font-weight: 600; }
+  .qs-binding-table-wrap .qs-binding-entity { grid-column: 1 / -1; border-block: 1px solid var(--color-line); }
+  .qs-binding-table-wrap .qs-binding-quantity { text-align: right; }
+  .qs-binding-table-wrap .qs-binding-highlight { margin-top: 10px; }
+}
+
+/* Legacy report presentation is normalised here without changing its export,
+   totals or disclosure logic. !important overrides its old inline palette. */
+.qs-quantity-report .qs-report-panel,
+.qs-quantity-report .qs-report-panel > *,
+.qs-quantity-report .qs-report-panel details { min-width: 0; max-width: 100%; }
+.qs-quantity-report .qs-report-panel :is(p, span, strong, td, th, code, div) { color: var(--color-ink) !important; }
+.qs-quantity-report .qs-report-panel :is(p, span, strong, td, th, code, label) { overflow-wrap: anywhere; }
+.qs-quantity-report .qs-report-panel > div:first-child > p:last-child,
+.qs-quantity-report .qs-report-panel > .industry-note { color: var(--color-muted) !important; }
+.qs-quantity-report .qs-overlap-warning-banner { background: var(--color-paper) !important; border-color: var(--color-warn) !important; }
+.qs-quantity-report .qs-overlap-warning-banner > div > div { min-width: 0; }
+.qs-quantity-report .qs-hierarchy-section,
+.qs-quantity-report .qs-hierarchy-section > div:first-child,
+.qs-quantity-report .qs-hierarchy-section thead tr { background: var(--color-paper) !important; border-color: var(--color-line) !important; }
+.qs-quantity-report .qs-hierarchy-section > div:first-child { flex-wrap: wrap; gap: 8px; }
+.qs-quantity-report .industry-table-wrap,
+.qs-quantity-report .qs-hierarchy-section > div:last-child { width: 100%; max-width: 100%; min-width: 0; overflow-x: auto; overscroll-behavior-inline: contain; }
+.qs-quantity-report .qs-report-panel :is(button, select) { max-width: 100%; min-height: 44px; white-space: normal; }
+.qs-quantity-report .qs-report-panel button { background: var(--color-paper) !important; color: var(--color-ink) !important; border: 1px solid var(--color-line) !important; }
+.qs-quantity-report .qs-report-panel [data-testid="export-hierarchical-csv-btn"] { background: var(--color-action) !important; color: var(--color-on-action) !important; }
+.qs-quantity-report .industry-fields > label { flex: 1 1 15rem; flex-wrap: wrap; max-width: 100%; }
+.qs-quantity-report .industry-fields > div { min-width: 0; max-width: 100%; flex-wrap: wrap; }
+.qs-quantity-report .qs-report-panel summary { min-height: 44px; padding-block: 10px; }
