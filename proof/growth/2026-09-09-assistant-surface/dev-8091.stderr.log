    '    const box = railMode && !rightCollapsed\n' +
    '      ? assistantRailBox(rail ? { left: rail.left + 2, top: rail.top, height: rail.height } : null, innerWidth, innerHeight)\n' +
    '      : null;\n' +
    '    const vars = assistantRailVars(box);\n' +
    '    if (box) root.setAttribute("data-assistant-rail", "true");\n' +
    '    else root.removeAttribute("data-assistant-rail");\n' +
    '    for (const name of ASSISTANT_RAIL_VARS) {\n' +
