    '  const [rects, setRects] = useState<\n' +
    '    { side: keyof RailWidths; left: number; top: number; height: number; collapsed: boolean }[]\n' +
    '  >([]);\n' +
    '  useEffect(() => {\n' +
    '    try {\n' +
    '      setWidths(readRailWidths(localStorage.getItem(RAIL_LAYOUT_KEY)));\n' +
    '    } catch { /* storage unavailable */ }\n' +
    '    try {\n' +
    '      if (readAssistantRail(localStorage.getItem(ASSISTANT_RAIL_KEY))) {\n' +
    '        setRailMode(true);\n' +
    '        useStudio.setState({ rightCollapsed: false });\n' +
    '        useLiveAssistant.setState({ open: true });\n' +
    '      }\n' +
    '    } catch { /* storage unavailable */ }\n' +
    '    setReady(true);\n' +
    '    const update = (event: Event) =>\n' +
    '      setWidths(readRailWidths(JSON.stringify((event as CustomEvent).detail)));\n' +
