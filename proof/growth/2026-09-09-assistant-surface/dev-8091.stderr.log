    'export function WorkspaceRails({ children, pane }: { children: ReactNode; pane: string }) {\n' +
    '  const ref = useRef<HTMLDivElement>(null);\n' +
    '  const [widths, setWidths] = useState<RailWidths>(DEFAULT_RAILS);\n' +
    '  const [ready, setReady] = useState(false);\n' +
    '  const [leftCollapsed, setLeftCollapsed] = useState(false);\n' +
    '  const rightCollapsed = useStudio(s => s.rightCollapsed);\n' +
    '  const collapsed = { left: leftCollapsed, right: rightCollapsed };\n' +
    "  // Assistant rail mode: the right menu's box becomes the Live assistant (assistantRailMode.ts).\n" +
    '  const [railMode, setRailMode] = useState(false);\n' +
    '  const assistantOpen = useLiveAssistant(s => s.open);\n' +
    '  const assistantWasOpen = useRef(false);\n' +
    '  const applyRail = (action: RailAction) => {\n' +
    '    const next = nextRailState({ rail: railMode, rightCollapsed }, action);\n' +
    '    setRailMode(next.rail);\n' +
    '    if (next.rightCollapsed !== rightCollapsed) useStudio.setState({ rightCollapsed: next.rightCollapsed });\n' +
    '    if (next.rail) useLiveAssistant.setState({ open: true });\n' +
    '  };\n' +
    '  const setCollapsed = (side: keyof RailWidths, value: boolean) => {\n' +
    '    if (side === "left") setLeftCollapsed(value);\n' +
    '    else applyRail(value ? "collapse-right" : "expand-right");\n' +
    '  };\n' +
    '  const drag = useRef<{ side: keyof RailWidths; x: number; width: number; collapsed: boolean; moved: boolean } | null>(null);\n' +
