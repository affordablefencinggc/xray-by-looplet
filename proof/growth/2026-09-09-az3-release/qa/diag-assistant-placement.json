  ["eval", "(()=>{const el=document.querySelector('.live-assistant');const r=el.getBoundingClientRect();return {after:'Home',rect:{l:r.left,t:r.top,r:r.right,b:r.bottom,w:r.width,h:r.height},innerWidth,innerHeight,active:document.activeElement?.getAttribute('aria-label'),style:el.getAttribute('style'),saved:localStorage.getItem('xray:assistant-panel:v1'),bottomGap:innerHeight-r.bottom}})()"],
