    "for(const b of document.querySelectorAll('.top-row-toggle')){const r=b.getBoundingClientRect();if(r.right>innerWidth||r.left<0||!b.contains(document.elementFromPoint(r.left+r.width/2,r.top+r.height/2)))throw Error('Top collapse button clipped or covered')}"
