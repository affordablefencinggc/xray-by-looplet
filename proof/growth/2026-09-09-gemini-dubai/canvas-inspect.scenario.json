  ["wait", "--fn", "document.querySelector('.workspace-rails').dataset.canvasFocus==='true'"],
  ["eval", "Array.from(document.querySelectorAll('.arch-canvases,.architect-workspace,.studio-main,.live-assistant-panel,.building-stage')).map(e=>({class:e.className,rect:e.getBoundingClientRect().toJSON(),position:getComputedStyle(e).position,left:getComputedStyle(e).left,right:getComputedStyle(e).right,width:getComputedStyle(e).width}))"],
