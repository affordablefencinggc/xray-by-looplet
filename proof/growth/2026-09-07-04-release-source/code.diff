+    assert.throws(() => changeSheetLifecycle(previous, { type: "rename", pageIndex: 0, name: " " }), /sheet name/);
+    assert.throws(() => changeSheetLifecycle(previous, { type: "archive", pageIndex: 4 }), /no longer/);
