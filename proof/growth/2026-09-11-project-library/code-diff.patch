+.project-library { display: grid; gap: 16px; padding: 20px; color: var(--color-ink); }
+.project-library p { line-height: 1.5; }
+.project-library label { display: grid; gap: 6px; font-size: 12px; flex: 1; }
+.project-library input { min-height: 44px; padding: 8px 12px; border: 1px solid var(--color-line); border-radius: 6px; width: 100%; }
+.project-library .pill { min-height: 44px; }
+.project-library-new, .project-library-toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; }
+.project-library-toolbar [role=group], .project-library-actions, .project-archive-review > div { display: flex; gap: 8px; }
+.project-library-list { display: grid; gap: 8px; }
+.project-library-list li { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px; border: 1px solid var(--color-line); border-radius: 8px; background: var(--color-card); }
+.project-library-list small, .project-library-list code { display: block; margin-top: 4px; color: var(--color-muted); font-size: 11px; overflow-wrap: anywhere; }
+.project-library-list strong { overflow-wrap: anywhere; }
+.project-library-list li > div:first-child { min-width: 0; }
+.project-library [aria-pressed=true] { background: var(--color-navy); color: var(--color-on-navy); }
+.project-archive-review { display: grid; gap: 12px; padding: 16px; background: var(--color-card); border: 1px solid var(--color-heading-line); border-radius: 8px; }
+.project-library-note { font-size: 12px; color: var(--color-muted); }
+.project-library [role=alert] { color: var(--color-danger, #9b2525); }
