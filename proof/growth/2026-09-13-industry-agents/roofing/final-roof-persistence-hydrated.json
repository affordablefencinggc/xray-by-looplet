[{"kind":"eval","name":"await-real-ui","expression":"new Promise(resolve=>{const check=()=>{if(document.querySelector('textarea')){observer.disconnect();clearTimeout(timer);resolve({ready:true,text:document.body.innerText})}};const observer=new MutationObserver(check);observer.observe(document.body,{subtree:true,childList:true});const timer=setTimeout(()=>{observer.disconnect();resolve({ready:false,text:document.body.innerText})},45000);check();})"}]
