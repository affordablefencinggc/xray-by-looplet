[{"kind":"eval","name":"wait-draft-response","expression":"new Promise(resolve=>{const check=()=>{if(!document.querySelector('button[aria-label=\"Stop assistant response\"]')){observer.disconnect();clearTimeout(timer);resolve({complete:true});}};const observer=new MutationObserver(check);observer.observe(document.body,{subtree:true,attributes:true,childList:true,characterData:true});const timer=setTimeout(()=>{observer.disconnect();resolve({complete:false});},45000);check();})"},{"kind":"eval","name":"draft-readback","expression":"(async()=>{const {useStudio}=await import('/src/studio/store.ts');const {readChatArchive}=await import('/src/studio/assistant/chatHistory.ts');const job=useStudio.getState().job;return {job,archive:await readChatArchive(job.id),text:document.body.innerText,toolRows:[...document.querySelectorAll('.assistant-tool-row')].map(x=>x.innerText),alerts:[...document.querySelectorAll('[role=alert]')].map(x=>x.innerText)};})()"},{"kind":"eval","name":"show-draft-review","expression":"(()=>{const n=[...document.querySelectorAll('h1,h2,h3,h4,p,strong')].filter(x=>x.textContent.trim()==='Developer review').at(-1);n?.scrollIntoView({block:'start'});return {found:!!n};})()"},{"kind":"screenshot","name":"form-browser-model-retry-review"}]
