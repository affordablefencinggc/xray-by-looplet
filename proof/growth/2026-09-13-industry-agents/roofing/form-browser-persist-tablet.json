[{"kind":"eval","name":"hydrated-estimate","expression":"new Promise((resolve,reject)=>{const check=()=>{const n=[...document.querySelectorAll('button')].find(n=>n.textContent==='Estimate');if(n){o.disconnect();clearTimeout(t);n.click();resolve(true)}};const o=new MutationObserver(check);o.observe(document.body,{subtree:true,childList:true});const t=setTimeout(()=>reject(Error('Hydration timeout')),45000);check()})"},{"kind":"eval","name":"expand","expression":"document.querySelector('.industry-workbench summary').click();true"},{"kind":"eval","name":"reloaded-inputs-result","expression":"new Promise((resolve,reject)=>{const check=()=>{if(document.querySelector('[data-draft-save=\"saved\"]')){o.disconnect();clearTimeout(t);resolve({save:'saved',inputs:[...document.querySelectorAll('.industry-form input')].map(n=>({id:n.id,value:n.value})),result:document.querySelector('.industry-result')?.innerText??null,error:document.querySelector('.industry-form [role=alert]')?.innerText??null});}};const o=new MutationObserver(check);o.observe(document.body,{subtree:true,childList:true,attributes:true});const t=setTimeout(()=>{o.disconnect();reject(Error('Draft not saved'))},12000);check();})"},{"kind":"viewport","name":"tablet","width":1024,"height":768},{"kind":"eval","name":"tablet-geometry","expression":"(()=>{document.querySelector('.industry-form').scrollIntoView({block:'start'});return {viewport:innerWidth,documentWidth:document.documentElement.scrollWidth,fields:[...document.querySelectorAll('.industry-form input')].map(n=>({id:n.id,rect:n.getBoundingClientRect().toJSON()}))}})()"},{"kind":"screenshot","name":"form-browser-tablet-fields"},{"kind":"eval","name":"tablet-result","expression":"document.querySelector('.industry-result').scrollIntoView({block:'center'});true"},{"kind":"screenshot","name":"form-browser-tablet-result"},{"kind":"clearViewport","name":"restore-desktop"},{"kind":"eval","name":"after-project","expression":"(async()=>{const {useStudio}=await import('/