[{"kind":"eval","name":"back","expression":"document.querySelector('button[aria-label=\"Back to conversation\"]').click();true"},{"kind":"eval","name":"menu","expression":"document.querySelector('button[aria-label=\"Add to assistant\"]').click();true"},{"kind":"eval","name":"menu-observed","expression":"document.querySelector('[aria-label=\"Add to assistant menu\"]').innerText"},{"kind":"eval","name":"new-chat","expression":"(()=>{const n=[...document.querySelectorAll('[role=\"menuitem\"]')].find(n=>n.textContent.trim()==='New chat');if(!n||n.disabled)throw Error('Newchat unavailable');n.click();return true})()"}]
