[{"kind":"eval","name":"archive","expression":"(async()=>{const {useStudio}=await import('/src/studio/store.ts');const {readChatArchive}=await import('/src/studio/assistant/chatHistory.ts');return {job:useStudio.getState().job,archive:await readChatArchive(useStudio.getState().job.id),busy:!!document.querySelector('button[aria-label=\"Stop assistant response\"]')}})()"},{"kind":"eval","name":"collapse","expression":"document.querySelector('button[aria-label=\"Collapse live assistant\"]')?.click();true"},{"kind":"eval","name":"estimate","expression":"[...document.querySelectorAll('button')].find(n=>n.textContent.trim()==='Estimate').click();true"},{"kind":"eval","name":"details","expression":"(()=>{for(const n of document.querySelectorAll('summary'))if(n.textContent.includes('Industry worksheets')&&!n.parentElement.open)n.click();const n=document.querySelector('.industry-sheet-coverage summary');if(n&&!n.parentElement.open)n.click();return true})()"},{"kind":"viewport","name":"tablet","width":820,"height":1000},{"kind":"eval","name":"show","expression":"document.querySelector('.industry-sheet-coverage').scrollIntoView({block:'end'});true"},{"kind":"screenshot","name":"sheet-coverage-tablet-unobstructed"},{"kind":"clearViewport","name":"restore"}]
