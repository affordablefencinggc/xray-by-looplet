[{"kind":"eval","name":"estimate","expression":"[...document.querySelectorAll('button')].find(n=>n.textContent.trim()==='Estimate').click();true"},{"kind":"eval","name":"worksheet-open","expression":"(()=>{const n=[...document.querySelectorAll('summary')].find(n=>n.textContent.includes('Industry worksheets'));if(n&&!n.parentElement.open)n.click();return {text:document.querySelector('.industry-form')?.innerText,selects:[...document.querySelectorAll('select')].map(n=>({aria:n.getAttribute('aria-label'),value:n.value,options:[...n.options].map(o=>({value:o.value,text:o.text}))}))}})()"}]
