[{"kind":"eval","name":"after-reload-archive","expression":"(async()=>{const {useStudio}=await import('/src/studio/store.ts');const {readChatArchive}=await import('/src/studio/assistant/chatHistory.ts');const job=useStudio.getState().job;return {job,archive:await readChatArchive(job.id)}})()"},{"kind":"eval","name":"close-open-estimate","expression":"(()=>{document.querySelector('button[aria-label=\"Collapse live assistant\"]')?.click();[...document.querySelectorAll('button')].find(n=>n.textContent==='Estimate').click();return true})()"},{"kind":"eval","name":"open-form","expression":"document.querySelector('.industry-workbench summary').click();true"},{"kind":"eval","name":"final-saved-result","expression":"new Promise((resolve,reject)=>{const check=()=>{if(document.querySelector('[data-draft-save=\"saved\"]')){o.disconnect();clearTimeout(t);resolve({save:'saved',inputs:[...document.querySelectorAll('.industry-form input')].map(n=>({id:n.id,value:n.value})),result:document.querySelector('.industry-result')?.innerText??null,error:document.querySelector('.industry-form [role=alert]')?.innerText??null});}};const o=new MutationObserver(check);o.observe(document.body,{subtree:true,childList:true,attributes:true});const t=setTimeout(()=>{o.disconnect();reject(Error('Draft not saved'))},12000);check();})"},{"kind":"eval","name":"leave-result-visible","expression":"document.querySelector('.industry-result').scrollIntoView({block:'center'});true"},{"kind":"screenshot","name":"form-browser-final-visible"}]
