{
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "hierarchyId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "hierarchyRevision": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "nodes": {
        "maxItems": 1000,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "parentId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "label",
            "parentId"
          ],
          "additionalProperties": false
        }
      },
      "items": {
        "maxItems": 100000,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "quantity": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "evidence": {
              "type": "string",
              "enum": [
                "measured",
                "inferred",
                "sample",
                "unverified"
              ]
            },
            "source": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "documentId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "sheet": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "regionId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 240
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "calibrationId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 240
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "documentId",
                    "sha256",
                    "revision",
                    "sheet",
                    "regionId",
                    "calibrationId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "quantity",
            "unit",
            "evidence",
            "source"
          ],
          "additionalProperties": false
        }
      },
      "assignments": {
        "maxItems": 100000,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "itemId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "required": [
            "itemId",
            "nodeId"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "hierarchyId",
      "hierarchyRevision",
      "nodes",
      "items",
      "assignments"
    ],
    "additionalProperties": false
  },
  "input": {
    "hierarchyId": "QA manual hierarchy",
    "hierarchyRevision": "1",
    "nodes": [
      {
        "id": "walls",
        "label": "Walls",
        "parentId": null
      }
    ],
    "items": [
      {
        "id": "a",
        "quantity": "0.1",
        "unit": "m2",
        "evidence": "unverified",
        "source": null
      },
      {
        "id": "b",
        "quantity": "0.2",
        "unit": "m2",
        "evidence": "unverified",
        "source": null
      }
    ],
    "assignments": [
      {
        "itemId": "a",
        "nodeId": "walls"
      },
      {
        "itemId": "b",
        "nodeId": "walls"
      }
    ]
  },
  "result": {
    "status": "draft-classification",
    "verifiedQuoteEligible": false,
    "hierarchyId": "QA manual hierarchy",
    "hierarchyRevision": "1",
    "classificationComplete": true,
    "rows": [
      {
        "id": "a",
        "quantity": "0.1",
        "unit": "m2",
        "evidence": "unverified",
        "source": null,
        "nodeId": "walls"
      },
      {
        "id": "b",
        "quantity": "0.2",
        "unit": "m2",
        "evidence": "unverified",
        "source": null,
        "nodeId": "walls"
      }
    ],
    "nodes": [
      {
        "id": "walls",
        "label": "Walls",
        "parentId": null,
        "direct": [
          {
            "unit": "m2",
            "evidence": "unverified",
            "quantity": "0.3",
            "itemCount": 2
          }
        ],
        "rollup": [
          {
            "unit": "m2",
            "evidence": "unverified",
            "quantity": "0.3",
            "itemCount": 2
          }
        ]
      }
    ],
    "totals": [
      {
        "unit": "m2",
        "evidence": "unverified",
        "quantity": "0.3",
        "itemCount": 2
      }
    ],
    "classifiedTotals": [
      {
        "unit": "m2",
        "evidence": "unverified",
        "quantity": "0.3",
        "itemCount": 2
      }
    ],
    "unclassifiedTotals": [],
    "unclassifiedItemIds": []
  }
}