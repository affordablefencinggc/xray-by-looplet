    "eval",
    "(()=>{const p=filmRead(),walls=p.walls.filter(w=>w.levelId===filmLevel),openings=p.openings.filter(o=>walls.some(w=>w.id===o.wallId));if(walls.length!==7||openings.length!==4)throw Error(\"Unexpected drawing counts\");return {walls:walls.length,openings:openings.length,roof:p.roofs.filter(r=>r.levelId===filmLevel).length,revision:p.revision}})()"
