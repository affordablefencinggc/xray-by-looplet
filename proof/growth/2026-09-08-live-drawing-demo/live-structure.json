  [
    "eval",
    "(()=>{window.filmPause=ms=>new Promise(r=>setTimeout(r,ms));window.filmRead=()=>{const id=document.querySelector('.architect-workspace').dataset.designId;return JSON.parse(localStorage.getItem('xray:architect:v1:'+encodeURIComponent(id)))};window.filmLevel=document.querySelector('select[aria-label=\"Design level\"]').value;window.filmPoint=async(x,y)=>{const svg=document.querySelector('svg[aria-label=\"Editable architectural plan\"]');const pt=new DOMPoint(x,y).matrixTransform(svg.getScreenCTM());svg.dispatchEvent(new PointerEvent('pointermove',{bubbles:true,clientX:pt.x,clientY:pt.y,pointerId:1}));await filmPause(200);svg.dispatchEvent(new PointerEvent('pointerdown',{bubbles:true,button:0,buttons:1,clientX:pt.x,clientY:pt.y,pointerId:1}));svg.dispatchEvent(new PointerEvent('pointerup',{bubbles:true,button:0,clientX:pt.x,clientY:pt.y,pointerId:1}));await filmPause(300);};const p=filmRead();if(p&&(p.walls.length||p.lines.length))throw Error('Expected fresh filming workspace');return {level:filmLevel};})()"
