@@ -0,0 +1,13 @@
+/* Supplier product research section, mounted at the end of the price books panel and reusing its field, pill and notice conventions. */
+.pricing-research { display: grid; gap: var(--price-gap, 16px); padding-top: var(--price-gap, 16px); border-top: 1px solid var(--color-line); min-width: 0; }
+.pricing-research header { display: flex; flex-wrap: wrap; gap: var(--price-gap, 16px); align-items: start; justify-content: space-between; }
+.pricing-research-form { display: grid; gap: var(--price-small-gap, 8px); min-width: 0; }
+.pricing-research button { min-height: 44px; min-width: 44px; }
+.pricing-research-status { font-size: 13px; }
+.pricing-research-failure strong { display: block; }
+.pricing-research-links { display: grid; gap: var(--price-small-gap, 8px); padding-left: 24px; list-style: decimal; }
+.pricing-research-links li { min-width: 0; overflow-wrap: anywhere; }
+.pricing-research-links a { display: inline-block; min-height: 44px; align-content: center; font-weight: 600; text-decoration: underline; color: var(--color-ink); }
+.pricing-research-links a:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }
+.pricing-research-url { display: block; font-size: 12px; color: var(--color-muted); overflow-wrap: anywhere; }
+@media (max-width: 600px) { .pricing-research-links { padding-left: 20px; } }
