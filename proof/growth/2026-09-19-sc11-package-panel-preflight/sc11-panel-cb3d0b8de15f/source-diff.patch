+.qs-package-panel {
+  --qs-package-space: 12px;
+  display: grid; gap: 16px; min-width: 0; padding-top: 20px;
+  border-top: 1px solid var(--color-line); color: var(--color-ink); font: inherit;
+}
+.qs-package-panel header { display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: var(--qs-package-space); }
+.qs-package-panel :is(h3,h4) { margin: 0; font-size: 16px; font-weight: 700; text-wrap: balance; }
+.qs-package-panel header span { border: 1px solid var(--color-line); border-radius: var(--radius-pill); padding: 4px 10px; color: var(--color-muted); background: var(--color-paper); }
+.qs-package-note { margin: 0; font-size: 12px; line-height: 1.5; color: var(--color-muted); overflow-wrap: anywhere; }
+.qs-package-section { display: grid; min-width: 0; gap: var(--qs-package-space); padding: var(--qs-package-space); border: 1px solid var(--color-line); border-radius: var(--radius-panel); }
+.qs-package-section legend { padding: 0 6px; font-weight: 700; }
+.qs-package-fields { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,220px),1fr)); gap: var(--qs-package-space); min-width: 0; }
+.qs-package-panel label { display: grid; min-width: 0; gap: 6px; color: var(--color-muted); font-size: 12px; font-weight: 600; }
+.qs-package-panel :is(input:not([type="checkbox"]),select,textarea) { width: 100%; min-width: 0; min-height: 44px; padding: 10px 12px; border: 1px solid var(--color-line); border-radius: var(--radius-pill); background: var(--color-field); color: var(--color-field-ink); font: inherit; }
+.qs-package-panel textarea { resize: vertical; border-radius: var(--radius-panel); }
+.qs-package-panel button { min-height: 44px; border: 1px solid var(--color-line); border-radius: var(--radius-pill); padding: 10px 14px; background: var(--color-card); color: var(--color-ink); font: inherit; font-weight: 600; white-space: normal; cursor: pointer; }
+.qs-package-panel button:disabled { opacity: .55; cursor: not-allowed; }
+.qs-package-panel summary { min-height: 44px; padding: 12px 0; cursor: pointer; font-weight: 600; }
+.qs-package-panel :is(button,input,select,textarea,summary):focus-visible,.qs-package-table-scroll:focus-visible { outline: 2px solid var(--color-action); outline-offset: 3px; }
+.qs-package-actions { display: flex; flex-wrap: wrap; gap: 10px; }
+.qs-package-error { margin: 0; color: var(--color-danger); border-left: 3px solid currentColor; padding: 8px 12px; overflow-wrap: anywhere; }
+.qs-package-hashes { margin: 0; display: grid; gap: 8px; }
+.qs-package-hashes > div { display: grid; grid-template-columns: minmax(100px,1fr) minmax(0,3fr); gap: var(--qs-package-space); }
+.qs-package-hashes dt { color: var(--color-muted); }
+.qs-package-hashes dd { margin: 0; }
+.qs-package-panel code { font-family: var(--font-mono); font-size: 11px; overflow-wrap: anywhere; }
+.qs-package-table-scroll { max-width: 100%; overflow: auto; border: 1px solid var(--color-line); border-radius: var(--radius-panel); }
+.qs-package-panel table { border-collapse: collapse; width: 100%; font-size: 12px; line-height: 1.5; }
+.qs-package-panel caption { text-align: left; padding: var(--qs-package-space); color: var(--color-muted); background: var(--color-paper); }
+.qs-package-panel :is(th,td) { padding: var(--qs-package-space); border-top: 1px solid var(--color-line); text-align: left; vertical-align: top; font-variant-numeric: tabular-nums; }
+.qs-package-panel thead { color: var(--color-muted); background: var(--color-paper); }
