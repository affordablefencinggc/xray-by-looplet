[
  [
    "open",
    "http://127.0.0.1:8080/"
  ],
  [
    "wait",
    "--fn",
    "document.querySelector('.workbench')?.dataset.hydrationStatus==='ready'"
  ],
  [
    "set",
    "viewport",
    "1024",
    "768"
  ],
  [
    "find",
    "role",
    "button",
    "click",
    "--name",
    "Model",
    "--exact"
  ],
  [
    "wait",
    "--fn",
    "[...document.querySelectorAll('button')].some(b=>b.textContent.includes('Open Redburn BR250157 plan in 3D')&&!b.disabled)"
  ],
  [
    "find",
    "role",
    "button",
    "click",
    "--name",
    "Open Redburn BR250157 plan in 3D",
    "--exact"
  ],
  [
    "wait",
    "--fn",
    "Number(document.querySelector('.building-canvas canvas')?.dataset.meshCount)>0"
  ],
  [
    "eval",
    "document.querySelector('.building-canvas canvas').requestPointerLock=()=>Promise.reject(new DOMException('Isolated tablet QA drag mode','NotAllowedError'));'Drag fallback armed'"
  ],
  [
    "find",
    "role",
    "button",
    "click",
    "--name",
    "Walk-through",
    "--exact"
  ],
  [
    "wait",
    "--fn",
    "document.querySelector('.walk-start-picker')?.dataset.startReady==='true'"
  ],
  [
    "eval",
    "(()=>{const c=document.querySelector('.walk-start-picker canvas'),r=c.getBoundingClientRect();c.dispatchEvent(new MouseEvent('click',{clientX:r.left+310.3405714285714/600*r.width,clientY:r.top+252.65142857142857/360*r.height,bubbles:true}));})()"
  ],
  [
    "wait",
    "--fn",
    "document.querySelector('.walk-start-picker')?.dataset.startReady==='true'"
  ],
  [
    "find",
    "role",
    "button",
    "click",
    "--name",
    "Start walking here",
    "--exact"
  ],
  [
    "wait",
    "--fn",
    "document.querySelector('.building-canvas canvas')?.dataset.navigation==='walk'&&document.querySelector('.building-canvas canvas').dataset.navigationTransition==='idle'"
  ],
  [
    "eval",
    "window.__tabletFrame=Number(document.querySelector('.building-canvas canvas').dataset.frameCount)"
  ],
  [
    "wait",
    "--fn",
    "Number(document.querySelector('.building-canvas canvas').dataset.frameCount)>window.__tabletFrame"
  ],
  [
    "eval",
    "(()=>{const c=document.querySelector('.building-canvas canvas'),r=c.getBoundingClientRect(),x=r.left+r.width/2,y=r.top+r.height/2,dx=(Number(c.dataset.navigationYaw)-Math.PI)/.002,dy=Number(c.dataset.navigationPitch)/.002;c.dispatchEvent(new PointerEvent('pointerdown',{pointerId:71,button:0,buttons:1,clientX:x,clientY:y,bubbles:true}));document.dispatchEvent(new PointerEvent('pointermove',{pointerId:71,buttons:1,clientX:x+dx,clientY:y+dy,bubbles:true}));document.dispatchEvent(new PointerEvent('pointerup',{pointerId:71,button:0,clientX:x+dx,clientY:y+dy,bubbles:true}));})()"
  ],
  [
    "wait",
    "--fn",
    "Math.abs(Number(document.querySelector('.building-canvas canvas').dataset.navigationYaw)-Math.PI)<.001&&!!document.querySelector('.walk-door-card button')"
  ],
  [
    "screenshot",
    "screenshots/growth/development-overlay-tablet-landscape-prompt-attempt1.png"
  ],
  [
    "eval",
    "(()=>{const selectors=['.walk-door-card','.walk-door-card button','.building-navigation-hint','[aria-label=\"Model navigation\"]'];return Object.fromEntries(selectors.map(s=>[s,[...document.querySelectorAll(s)].map(e=>({text:e.textContent,rect:e.getBoundingClientRect().toJSON()}))]))})()"
  ]
]
