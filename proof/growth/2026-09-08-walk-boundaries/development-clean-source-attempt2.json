  ],
  [
    "eval",
    "(()=>{const s=document.querySelector('.walk-clean-plan'),p=new DOMPoint(0,2.1).matrixTransform(s.getScreenCTM());if(p.x<0||p.x>innerWidth||p.y<0||p.y>innerHeight)throw Error('Plan test point not visible '+JSON.stringify(p));s.dispatchEvent(new MouseEvent('click',{clientX:p.x,clientY:p.y,bubbles:true}));return {world:[0,2.1],client:[p.x,p.y]}})()"
  ],
  [
    "wait",
    "--fn",
    "document.querySelector('.walk-start-picker').dataset.startReady==='true'"
  ],
  [
    "eval",
    "window.__retainedStart=document.querySelector('.walk-start-selected').textContent;document.querySelector('.walk-clean-plan').scrollIntoView({block:'center',behavior:'instant'})"
  ],
  [
    "eval",
    "(()=>{const s=document.querySelector('.walk-clean-plan'),b=s.viewBox.baseVal,p=new DOMPoint(b.x+.2,b.y+.2).matrixTransform(s.getScreenCTM());if(p.y<0||p.y>innerHeight)throw Error('Unsupported test point outside visible plan');s.dispatchEvent(new MouseEvent('click',{clientX:p.x,clientY:p.y,bubbles:true}));})()"
  ],
  [
    "wait",
    "--fn",
    "document.querySelector('.walk-start-picker').dataset.startReady==='false'"
  ],
  [
    "eval",
    "if(document.querySelector('.walk-start-selected').textContent!==window.__retainedStart||!document.querySelector('.walk-start-footer button').disabled||!document.querySelector('.walk-start-picker [role=alert]'))throw Error('Unsupported selection did not preserve previous start and block continuation');'Unsupported point refused with prior start retained'"
