    "find",
    "role",
    "button",
    "click",
    "--name",
    "Walk-through",
    "--exact"
  ],
  [
    "wait",
    "--fn",
    "!!document.querySelector('.walk-clean-plan')"
  ],
  [
    "set",
    "viewport",
    "1440",
    "1000"
  ],
  [
    "eval",
    "document.querySelector('.walk-clean-plan').scrollIntoView({block:'center',behavior:'instant'})"
  ],
  [
    "wait",
    "--fn",
    "innerWidth===1440&&innerHeight===1000"
  ],
  [
    "screenshot",
    "screenshots/growth/development-clean-source-attempt2-desktop-plan-final.png"
  ],
  [
    "eval",
    "document.querySelector('.walk-start-footer').scrollIntoView({block:'center',behavior:'instant'});'Scrolled to walking action'"
  ],
  [
    "wait",
    "--fn",
    "(()=>{const b=document.querySelector('.walk-start-footer button'),r=b.getBoundingClientRect();return r.top>=0&&r.bottom<innerHeight})()"
  ],
  [
    "eval",
    "(()=>{const b=document.querySelector('.walk-start-footer button'),r=b.getBoundingClientRect();if(r.height<44||!b.contains(document.elementFromPoint(r.x+r.width/2,r.y+r.height/2)))throw Error('Start action clipped or too small');return {button:r.toJSON(),disabled:b.disabled}})()"
  ],
  [
    "screenshot",
    "screenshots/growth/development-clean-source-attempt2-desktop-action-final.png"
  ],
