  [
    "eval",
    "(()=>{const p=document.querySelector('.building-canvas canvas').dataset.walkFeet.split(',').map(Number);if(Math.abs(p[0])>.03||Math.abs(p[2]-2.1)>.03)throw Error('Wrong valid start '+p);return {feet:p}})()"
