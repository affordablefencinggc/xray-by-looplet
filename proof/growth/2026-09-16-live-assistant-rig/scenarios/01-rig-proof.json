[
  ["open", "http://127.0.0.1:8085/"],
  ["wait", "--fn", "document.querySelector('[data-hydration-status]')?.getAttribute('data-hydration-status')==='ready'"],
  ["eval", "localStorage.setItem('xray:assistant-provider:v2','minimax'); location.reload(); 'reloading-with-minimax'"],
  ["wait", "--fn", "document.querySelector('[data-hydration-status]')?.getAttribute('data-hydration-status')==='ready'"],
  ["eval", "(async()=>{const s=await (await fetch('/api/minimax-ai')).json();window.__qaProvider=s;return 'kicked'})()"],
  ["wait", "--fn", "!!window.__qaProvider"],
  ["eval", "(()=>{const s=window.__qaProvider;if(!s.available)throw Error('Provider unavailable');if(s.model!=='MiniMax-M3')throw Error('Wrong model: '+s.model);return JSON.stringify({provider:s.provider,model:s.model,stored:localStorage.getItem('xray:assistant-provider:v2')})})()"],
  ["eval", "(()=>{const b=[...document.querySelectorAll('button')].find(x=>x.textContent.trim()==='Live assistant');if(!b)throw Error('No Live assistant launcher');b.click();return 'opened'})()"],
  ["wait", "--fn", "!!document.querySelector('textarea[placeholder^=\"Ask anything\"]')"],
  ["eval", "(async()=>{const {useStudio}=await import('/src/studio/store.ts');const h=await import('/src/studio/assistant/chatHistory.ts');window.__qaJob=useStudio.getState().job.id;const a=await h.readChatArchive(window.__qaJob);window.__qaBefore={jobId:window.__qaJob,activeId:a?.activeId??null,threads:(a?.threads??[]).map(t=>({id:t.id,entries:t.entries.length}))};return 'kicked'})()"],
  ["wait", "--fn", "!!window.__qaBefore"],
  ["eval", "JSON.stringify(window.__qaBefore)"],
  ["eval", "(()=>{const t=document.querySelector('textarea[placeholder^=\"Ask anything\"]');Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype,'value').set.call(t,'No tools. Reply with exactly: LIVE TURN OK');t.dispatchEvent(new Event('input',{bubbles:true}));return 'composed'})()"],
  ["wait", "--fn", "document.querySelector('button[aria-label=\"Send assistant message\"]')?.disabled===false"],
  ["screenshot", "proof/growth/2026-09-16-live-assistant-rig/01-rig-proof-composed.png"],
  ["eval", "(()=>{document.querySelector('button[aria-label=\"Send assistant message\"]').click();return 'sent'})()"],
  ["eval", "(()=>{window.__qa=null;const tick=async()=>{try{const h=await import('/src/studio/assistant/chatHistory.ts');const a=await h.readChatArchive(window.__qaJob);const t=a?.threads.find(x=>x.id===a.activeId);if(t?.error){window.__qa={state:'error',detail:t.error,entries:t.entries.map(e=>({kind:e.kind,text:(e.text||'').slice(0,4000)}))};return}if(t&&!t.busy&&t.entries.some(e=>e.kind==='assistant')){window.__qaArchive=a;window.__qa={state:'done',entries:t.entries.map(e=>({kind:e.kind,tool:e.tool??null,failed:e.failed??null,text:(e.text||'').slice(0,4000)}))};return}setTimeout(tick,1000)}catch(e){window.__qa={state:'threw',detail:String(e)}}};tick();return 'polling'})()"],
  ["wait", "--fn", "!!window.__qa"],
  ["screenshot", "proof/growth/2026-09-16-live-assistant-rig/01-rig-proof-replied.png"],
  ["eval", "JSON.stringify(window.__qa)"],
  ["eval", "JSON.stringify({usage:window.__qaArchive?.threads.find(t=>t.id===window.__qaArchive.activeId)?.entries.length,contents:null})"],
  ["errors"]
