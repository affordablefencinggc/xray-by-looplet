[
    [
        "open",
        "http://127.0.0.1:8080/"
    ],
    [
        "set",
        "viewport",
        "1440",
        "900"
    ],
    [
        "wait",
        "--fn",
        "document.querySelector(\u0027.workbench\u0027)?.dataset.hydrationStatus===\u0027ready\u0027"
    ],
    [
        "find",
        "role",
        "button",
        "click",
        "--name",
        "Model",
        "--exact"
    ],
    [
        "wait",
        "--fn",
        "!!document.querySelector(\u0027.building-workspace\u0027)"
    ],
    [
        "find",
        "role",
        "button",
        "click",
        "--name",
        "Crown Wharf A4 tower",
        "--exact"
    ],
    [
        "wait",
        "--fn",
        "document.querySelector(\u0027.building-center-column\u0027)?.textContent.includes(\u0027Crown Wharf\u0027)"
    ],
    [
        "find",
        "role",
        "button",
        "click",
        "--name",
        "Explore \u0026 Draw 3D Model",
        "--exact"
    ],
    [
        "wait",
        "--fn",
        "!!document.querySelector(\u0027.building-canvas canvas\u0027)"
    ],
    [
        "wait",
        "--fn",
        "Number(document.querySelector(\u0027.building-canvas canvas\u0027)?.dataset.frameCount) \u003e 2"
    ],
    [
        "find",
        "role",
        "button",
        "click",
        "--name",
        "Magic Pencil",
        "--exact"
    ],
    [
        "wait",
        "--fn",
        "document.querySelector(\u0027.building-canvas canvas\u0027)?.dataset.drawMode === \u0027active\u0027"
    ],
    [
        "wait",
        "--fn",
        "!!document.querySelector(\u0027[data-testid=\"draftsman-dock\"]\u0027)"
    ],
    [
        "find",
        "role",
        "button",
        "click",
        "--name",
        "Pause drawing",
        "--exact"
    ],
    [
        "find",
        "role",
        "tab",
        "click",
        "--name",
        "2. Wireframe Ascend",
        "--exact"
    ],
    [
        "wait",
        "--fn",
        "document.querySelector(\".building-canvas canvas\").dataset.drawPhase === \"ascending_wireframe\""
    ],
    [
        "screenshot",
        "screenshots/growth/2026-09-08-takeover-wireframe.png"
    ],
    [
        "find",
        "role",
        "tab",
        "click",
        "--name",
        "4. Material Wash",
        "--exact"
    ],
    [
        "wait",
        "--fn",
        "document.querySelector(\".building-canvas canvas\").dataset.drawPhase === \"material_wash\""
    ],
    [
        "screenshot",
        "screenshots/growth/2026-09-08-takeover-shading.png"
    ],
    [
        "find",
        "role",
        "button",
        "click",
        "--name",
        "Solid Finish",
        "--exact"
    ],
    [
        "wait",
        "--fn",
        "document.querySelector(\".building-canvas canvas\").dataset.drawPhase === \"complete\""
    ],
    [
        "find",
        "role",
        "button",
        "click",
        "--name",
        "Close Draftsman mode",
        "--exact"
    ],
    [
        "wait",
        "--fn",
        "!document.querySelector(\"[data-testid=draftsman-dock]\") \u0026\u0026 !window.__magicPencil"
    ],
    [
        "screenshot",
        "screenshots/growth/2026-09-08-takeover-restored.png"
    ],
    [
        "errors"
    ]
]