[
  [
    "open",
    "http://127.0.0.1:8080/"
  ],
  [
    "wait",
    "--fn",
    "!!document.querySelector('[data-hydration-status=ready]')"
  ],
  [
    "eval",
    "(async()=>{window.__mcpApi=await import('/src/studio/assistant/session.ts');window.__mcp=await __mcpApi.getAssistantMcp();window.__callMcp=async(name,args)=>{const r=await __mcpApi.callAssistantTool(name,args,new AbortController().signal);if(r.isError)throw Error(JSON.stringify(r.content));return JSON.parse(r.content[0].text)};window.__mcpContext=await __callMcp('read_project_context',{});return {names:__mcp.tools.map(x=>x.name),context:__mcpContext}})()"
  ],
  [
    "eval",
    "(async()=>{await __callMcp('navigate_workspace',{expectedJobId:__mcpContext.projectId,pane:'sketch'});return true})()"
  ],
  [
    "wait",
    "--fn",
    "!!document.querySelector('.architect-workspace[data-design-id]')"
  ],
  [
    "eval",
    "(async()=>{window.__mcpBefore=await __callMcp('read_architect_design',{expectedJobId:__mcpContext.projectId});return __mcpBefore})()"
  ],
  [
    "snapshot"
  ]
]