[
  [
    "set",
    "viewport",
    "1440",
    "1000"
  ],
  [
    "eval",
    "(async()=>{window.__mcpContext=await __callMcp('read_project_context',{});await __callMcp('navigate_workspace',{expectedJobId:__mcpContext.projectId,pane:'sketch'});window.__mcpBefore=await __callMcp('read_architect_design',{expectedJobId:__mcpContext.projectId});return {id:__mcpContext.projectId,beforeRevision:__mcpBefore.project.revision}})()"
  ],
  [
    "eval",
    "(async()=>{const levelId=__mcpBefore.project.levels[0].id;window.__mcpDraw=await __callMcp('draw_architect_elements',{expectedJobId:__mcpContext.projectId,expectedRevision:__mcpBefore.project.revision,operations:[{kind:'wall',ref:'south',levelId,a:[0,0],b:[6000,0]},{kind:'wall',ref:'east',levelId,a:[6000,0],b:[6000,4000]},{kind:'wall',ref:'north',levelId,a:[6000,4000],b:[0,4000]},{kind:'wall',ref:'west',levelId,a:[0,4000],b:[0,0]},{kind:'door',wallRef:'south',offsetMm:2000,widthMm:900,heightMm:2100,tag:'D-QA',hinge:'left',swing:'in'},{kind:'window',wallRef:'east',offsetMm:1000,widthMm:1200,heightMm:1200,sillMm:900,tag:'W-QA',hinge:'left',swing:'in'}]});return __mcpDraw})()"
  ],
  [
    "wait",
    "--fn",
    "Number(document.querySelector('.architect-workspace')?.dataset.designRevision)>__mcpBefore.project.revision"
  ],
  [
    "eval",
    "(async()=>{window.__mcpDrawn=await __callMcp('read_architect_design',{expectedJobId:__mcpContext.projectId});if(__mcpDrawn.project.walls.length!==__mcpBefore.project.walls.length+4||__mcpDrawn.project.openings.length!==__mcpBefore.project.openings.length+2)throw Error('Geometry mismatch');if(JSON.stringify(__mcpDrawn.project.sheet)!==JSON.stringify(__mcpBefore.project.sheet))throw Error('Sheet changed');return {revision:__mcpDrawn.project.revision,walls:__mcpDrawn.project.walls.length,openings:__mcpDrawn.project.openings.length}})()"
  ],
  [
    "wait",
    "--fn",
    "Number(document.querySelector('canvas[aria-label=\"Live architectural 3D model\"]')?.dataset.projectRevision)===__mcpDrawn.project.revision"
  ],
  [
    "screenshot",
    "screenshots/growth/draftsman-mcp-agent-drawn-desktop.png"
  ],
  [
    "eval",
    "(async()=>{const c=await __callMcp('read_project_context',{});return await __callMcp('save_project',{expectedJobId:c.projectId,expectedRevision:c.projectRevision})})()"
  ],
  [
    "eval",
    "(async()=>{return await __callMcp('undo_architect_change',{expectedJobId:__mcpContext.projectId,expectedRevision:__mcpDrawn.project.revision})})()"
  ],
  [
    "wait",
    "--fn",
    "Number(document.querySelector('.architect-workspace')?.dataset.designRevision)>__mcpDrawn.project.revision"
  ],
  [
    "eval",
    "(async()=>{window.__mcpUndo=await __callMcp('read_architect_design',{expectedJobId:__mcpContext.projectId});for(const key of ['walls','openings','lines','roomTags','sheet','sheetSet'])if(JSON.stringify(__mcpUndo.project[key])!==JSON.stringify(__mcpBefore.project[key]))throw Error('Undo did not restore '+key);return {undoVerified:true,revision:__mcpUndo.project.revision}})()"
  ],
  [
    "screenshot",
    "screenshots/growth/draftsman-mcp-agent-undo-desktop.png"
  ],
