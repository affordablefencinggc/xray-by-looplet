+  assert.equal(snapshot(input).baseTotal.totalMinor, 5); // 3 × .01 × 1.5 = .045, not 3 × .02.
+  input.items[0].unit = "m²"; input.items[0].binding!.unit = "m²"; input.items[0].entity!.unit = "m²";
