    "(()=>{window.qaKey=Object.keys(localStorage).find(k=>k.startsWith('xray:architect:v1:'));const fixture=JSON.parse(localStorage.getItem(qaKey));fixture.name='Synthetic solid wall QA';const wall=fixture.walls[0];wall.a=[0,0];wall.b=[4000,0];wall.height=2700;wall.layers=[{...wall.layers[0],kind:'solid',thickness:200,name:'Declared QA solid'}];wall.lifecycle={status:'existing',reference:'Synthetic stage QA survey'};fixture.walls=[wall];const opening=fixture.openings.find(o=>o.kind==='window');opening.wallId=wall.id;opening.offset=1000;opening.width=900;opening.height=2100;opening.sill=300;opening.lifecycle={status:'new',reference:'Synthetic stage QA survey'};fixture.openings=[opening];fixture.slabs=[];fixture.roofs=[];fixture.lines=[];fixture.circles=[];fixture.arcs=[];fixture.dimensions=[];fixture.roomTags=[];fixture.grids=[];window.qaDivider=wall.id;window.qaWindow=opening.id;const dt=new DataTransfer();dt.items.add(new File([JSON.stringify(fixture)],'synthetic-solid-wall.json',{type:'application/json'}));const input=document.querySelector('.architect-header input[accept=\".json\"]');input.files=dt.files;input.dispatchEvent(new Event('change',{bubbles:true}));return {syntheticFixture:true}})()"
