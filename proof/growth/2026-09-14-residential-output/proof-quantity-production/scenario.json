    "(()=>{const q=document.querySelector('.alteration-volume-values');if(!q)throw Error('quantities unavailable');const values=[...q.querySelectorAll('dd')].map(d=>Number(d.textContent.replace(' m????????????????????????????????????????????','').replaceAll(',','')));if(Math.abs(values[0]-2.16)>0.000001||Math.abs(values[1]-1.782)>0.000001||Math.abs(values[2]+0.378)>0.000001)throw Error('volume comparison mismatch '+values);window.qaPdf=[];window.qaDownloadNames=[];const nativeURL=URL.createObjectURL.bind(URL);URL.createObjectURL=(blob)=>{if(blob.type==='application/pdf')qaPdf.push(blob);return nativeURL(blob)};const nativeClick=HTMLAnchorElement.prototype.click;HTMLAnchorElement.prototype.click=function(){if(this.download.endsWith('.pdf'))qaDownloadNames.push(this.download);return nativeClick.call(this)};document.querySelector('.alteration-stage-quantities').scrollIntoView({block:'center'});return {values,units:'m3',syntheticSolidLayers:true}})()"
