[["eval","(async()=>{const {useStudio}=await import('/src/studio/store.ts');const {loadArchitect}=await import('/src/studio/architect/persistence.ts');const {buildDesignedScene}=await import('/src/studio/architect/designedScene.ts');const {listWorkPackets,readWorkEvents}=await import('/src/studio/assistant/workPacketStore.ts');const {inspectCourtyard}=await import('/scripts/benchmarks/courtyard.mjs');const p=loadArchitect(useStudio.getState().job.id,localStorage).value,scene=buildDesignedScene(p),packets=await listWorkPackets(p.id);return {design:p,report:inspectCourtyard(p,{stage:1,scene}),packets,events:await Promise.all(packets.map(packet=>readWorkEvents(packet.id))),timeOrigin:performance.timeOrigin,panel:document.querySelector('[aria-label=\"Drawing assistant panel\"]')?.innerText};})()"]]