[
 [
  "open",
  "http://127.0.0.1:8091/",
  "--timeout",
  "120000"
 ],
 [
  "set",
  "viewport",
  "1280",
  "800"
 ],
 [
  "wait",
  "--fn",
  "document.querySelector('[data-hydration-status]')?.getAttribute('data-hydration-status')==='ready'",
  "--timeout",
  "120000"
 ],
 [
  "eval",
  "(()=>{const real=indexedDB.open.bind(indexedDB);indexedDB.open=(name,ver)=>{if(name==='xray-assistant-context-v1')throw Error('IndexedDB unavailable (induced for proof)');return real(name,ver)};return 'only the context store is broken'})()"
 ],
 [
  "eval",
  "(()=>{const l=document.querySelector('.live-assistant-launcher');if(!l)return 'NO_LAUNCHER';l.click();return 'opened'})()"
 ],
 [
  "wait",
  "--fn",
  "!!document.querySelector('#live-assistant-prompt')",
  "--timeout",
  "60000"
 ],
 [
  "eval",
  "(()=>{const p=document.querySelector('#live-assistant-prompt');const s=Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype,'value').set;s.call(p,'Say READY in one word.');p.dispatchEvent(new Event('input',{bubbles:true}));return 'typed'})()"
 ],
 [
  "eval",
  "(()=>{document.querySelector('#live-assistant-prompt').closest('form').requestSubmit();return 'submitted'})()"
 ],
 [
  "wait",
  "--fn",
  "document.body.innerText.includes('Carried context')||!!document.querySelector('.assistant-chat-error')||document.querySelectorAll('.assistant-chat-entry').length>1",
  "--timeout",
  "300000"
 ],
 [
  "eval",
  "(()=>{return 'NOTICE:'+document.body.innerText.includes('Carried context')})()"
 ],
 [
  "screenshot",
  "screenshots/growth/2026-09-10-context-wiring/desktop-04-carried-context-unavailable.png"
 ],
 [
  "eval",
  "(()=>{const e=document.querySelector('.assistant-chat-error');return 'BANNER:'+(e?e.textContent.trim().slice(0,140):'none')})()"
 ],
 [
  "eval",
  "(()=>{return 'ENTRIES:'+document.querySelectorAll('.assistant-chat-entry').length})()"
 ],
 [
  "eval",
  "(()=>{return 'SENTINEL_VISIBLE:'+document.body.innerText.includes('[xray:pinned-context]')})()"
 ]
]