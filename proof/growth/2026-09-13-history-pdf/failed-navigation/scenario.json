    "eval",
    "tabs",
    "window.tabErrors=[];addEventListener('error',e=>tabErrors.push(e.message));window.checkTabs=()=>{const r=document.querySelector('.workflow-main-tabs').getBoundingClientRect();if(Math.abs(r.x+r.width/2-innerWidth/2)>2)throw Error('Main tabs not centered');const seam=parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--assistant-seam-left'));for(const b of document.querySelectorAll('.top-row-toggle')){const v=b.getBoundingClientRect();if(Math.abs(v.x+v.width/2-seam)>2)throw Error('Arrow does not align with right rail');}return {center:r.x+r.width/2,seam};};checkTabs()"
