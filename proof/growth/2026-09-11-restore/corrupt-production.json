    "(async()=>{const db=await new Promise((resolve,reject)=>{const r=indexedDB.open('xray-workspace-restore-v1',1);r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error)});await new Promise((resolve,reject)=>{const tx=db.transaction('journal','readwrite'),s=tx.objectStore('journal'),p=s.get('active');p.onsuccess=()=>{const r=s.get(p.result);r.onsuccess=()=>s.put({...r.result,sha256:'0'.repeat(64)},p.result)};tx.oncomplete=resolve;tx.onabort=()=>reject(tx.error)});db.close();return true})()"
