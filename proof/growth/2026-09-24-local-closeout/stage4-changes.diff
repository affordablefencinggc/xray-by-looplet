+    Write-Output ($record | ConvertTo-Json -Compress)
+  }
+  if ($record.error -or $record.forced -or -not $record.exited) { throw 'Native gate failed; preserved partial evidence.' }
+}
diff --git a/proof/growth/2026-09-24-local-closeout/native-readback-probe.mjs b/proof/growth/2026-09-24-local-closeout/native-readback-probe.mjs
