diff --git a/src/studio/WorkflowNavigation.tsx b/src/studio/WorkflowNavigation.tsx
new file mode 100644
--- /dev/null
+++ b/src/studio/WorkflowNavigation.tsx
@@ -0,0 +1,36 @@
+import { AdjustableTopRow } from './AdjustableTopRow';
+import type { Pane } from './store';
+import './workflowNavigation.css';
+
+const workflows: { label: string; panes: { id: Pane; label: string }[]; hint: string }[] = [
+  { label: 'Drawings', panes: [{ id: 'sheets', label: 'Sheets & files' }], hint: 'Open and organise your source drawings' },
+  { label: 'Takeoff', panes: [{ id: 'measure', label: 'Measure' }, { id: 'components', label: 'Quantities & components' }], hint: 'Set the scale, then measure' },
+  { label: 'Design', panes: [{ id: 'sketch', label: 'Design workspace' }], hint: 'Draw and edit your building' },
+  { label: 'Visualise', panes: [{ id: 'model', label: '3D viewer' }, { id: 'render', label: 'Renders' }], hint: 'Explore and present your design' },
+  { label: 'Estimate', panes: [{ id: 'cost', label: 'Costs & pricing' }], hint: 'Review quantities and build your estimate' },
+];
+const checks: { id: Pane; label: string }[] = [{ id: 'review', label: 'Review issues' }, { id: 'proof', label: 'Evidence & exports' }];
+
+export function WorkflowNavigation({ pane, onSelect }: { pane: Pane; onSelect: (pane: Pane) => void }) {
+  const workflow = workflows.find(w => w.panes.some(p => p.id === pane));
+  const checking = checks.some(p => p.id === pane);
+  const items = checking ? checks : workflow?.panes ?? [{ id: 'overview' as Pane, label: 'Project overview' }];
+  return <>
+    <AdjustableTopRow id="navigation" label="Navigation" minHeight={44}>
+      <nav className="workflow-nav" aria-label="Main workflow">
+        {workflows.map(w => <button key={w.label} type="button" aria-current={workflow === w ? 'page' : undefined}
+          onClick={() => onSelect(workflow === w ? pane : w.panes[0].id)}>{w.label}</button>)}
+        <button type="button" className="workflow-checks" aria-current={checking ? 'page' : undefined}
+          onClick={() => onSelect(checking ? pane : 'review')}>Checks</button>
+      </nav>
+    </AdjustableTopRow>
+    <AdjustableTopRow id="mode" label="Workspace tools" minHeight={44}>
+      <nav className="workflow-context" aria-label="Workspace tools">
+        <span className="workflow-context-label">{checking ? 'Checks' : workflow?.label ?? 'Project'}</span>
+        {items.map(p => <button key={p.id} type="button" aria-current={pane === p.id ? 'page' : undefined}
+          onClick={() => onSelect(p.id)}>{p.label}</button>)}
+        <span className="workflow-context-hint">{checking ? 'Review issues and supporting evidence' : workflow?.hint ?? 'Your project at a glance'}</span>
+      </nav>
+    </AdjustableTopRow>
+  </>;
+}
diff --git a/src/studio/workflowNavigation.css b/src/studio/workflowNavigation.css
new file mode 100644
--- /dev/null
+++ b/src/studio/workflowNavigation.css
@@ -0,0 +1,22 @@
+.workflow-nav, .workflow-context { display: flex; align-items: center; gap: 8px; min-height: 44px; height: 100%; padding: 0 16px; }
+.workflow-nav button, .workflow-context button { flex-shrink: 0; min-height: 40px; padding: 8px 16px; color: var(--color-muted); background: transparent; border: 0; font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; }
+.workflow-nav button:hover, .workflow-context button:hover { background: var(--color-selected); color: var(--color-ink); }
+.workflow-nav button[aria-current] { color: var(--color-ink); box-shadow: inset 0 -2px var(--color-accent, var(--color-ink)); background: var(--color-selected); }
+.workflow-nav .workflow-checks { margin-left: auto; border-left: 1px solid var(--color-line); }
+.workflow-context { gap: 8px; }
+.workflow-context-label { font-size: 11px; color: var(--color-muted); padding-right: 12px; border-right: 1px solid var(--color-line); }
+.workflow-context button { font-size: 12px; padding: 6px 12px; min-height: 36px; border-radius: 5px; }
+.workflow-context button[aria-current] { background: var(--color-card); color: var(--color-ink); box-shadow: inset 0 0 0 1px var(--color-line); }
+.workflow-context-hint { margin-left: auto; color: var(--color-muted); font-size: 11px; white-space: nowrap; }
+.project-identity { display: flex; flex-direction: column; min-width: 0; gap: 2px; }
+.project-identity button { color: var(--color-ink); font-size: 13px; font-weight: 600; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 260px; cursor: pointer; }
+.project-identity small { color: var(--color-muted); font-size: 10px; }
+.project-menu-trigger { display: inline-flex; align-items: center; gap: 8px; }
+.workbench .workspace-dialog:has(.project-menu-content) { width: min(680px, calc(100vw - 48px)); }
+.project-menu-content { display: grid; gap: 16px; padding: 24px; }
+.project-menu-content .workspace-plan-switcher { max-width: none; }
+.project-menu-content .workspace-plan-switcher label { flex-direction: column; align-items: stretch; }
+.project-menu-content .workspace-plan-controls { flex-wrap: wrap; }
+.project-menu-content .backup-trigger { justify-self: start; }
+@media (max-width: 1100px) { .workflow-context-hint { display: none; } .workbench .studio-brand > span:last-child { display: none; } }
+@media (max-width: 700px) { .workflow-nav, .workflow-context { overflow-x: auto; padding-inline: 8px; } .workflow-nav button { padding-inline: 12px; } .project-identity button { max-width: 160px; } }
