    "eval",
    "(()=>{const bars=[...document.querySelectorAll('.workflow-nav,.workflow-context,.studio-header')];if(bars.some(b=>b.scrollWidth>b.clientWidth+2))throw Error('Top menu overflows');return bars.map(b=>({width:b.clientWidth,scroll:b.scrollWidth}))})()"
  ],
  [
    "screenshot",
    "tablet-takeoff.png"
  ],
  [
    "eval",
    "(()=>{for(const id of ['header','navigation','mode']){const row=document.querySelector('[data-top-row=\"'+id+'\"]');row.querySelector('[role=\"separator\"]').dispatchEvent(new KeyboardEvent('keydown',{key:'ArrowDown',bubbles:true}));row.querySelector('.top-row-toggle').click()}return true})()"
  ],
  [
    "wait",
    "[...document.querySelectorAll('[data-top-row]')].every(r=>r.dataset.collapsed==='true')"
  ],
  [
    "navigate",
    "http://127.0.0.1:8081"
  ],
  [
    "wait",
    "document.querySelector('[data-hydration-status]')?.dataset.hydrationStatus==='ready' && [...document.querySelectorAll('[data-top-row]')].length===3 && [...document.querySelectorAll('[data-top-row]')].every(r=>r.dataset.collapsed==='true')"
  ],
  [
    "eval",
    "document.querySelectorAll('.top-row-toggle').forEach(b=>b.click())"
  ],
  [
    "wait",
    "[...document.querySelectorAll('[data-top-row]')].every(r=>r.dataset.collapsed==='false')"
  ],
  [
    "eval",
    "(()=>{const rows=[...document.querySelectorAll('[data-top-row]')].map(r=>({id:r.dataset.topRow,height:r.getBoundingClientRect().height,saved:JSON.parse(localStorage.getItem('xray:top-row:'+r.dataset.topRow+':v1'))}));if(rows.some(r=>Math.abs(r.height-r.saved.height)>1))throw Error('Row sizes not restored');if(document.querySelector('.project-identity button').textContent!=='Navigation proof project')throw Error('Rename not saved');return rows})()"
