[["eval","(()=>{const host=document.querySelector('.price-books');const l=document.createElement('label');l.className='bom-round-up';l.innerHTML='<input type=\"checkbox\">Round up';host.appendChild(l);const cs=getComputedStyle(l),box=l.querySelector('input').getBoundingClientRect(),lb=l.getBoundingClientRect();const r={display:cs.display,checkboxW:Math.round(box.width),sameRow:Math.abs((box.top+box.bottom)/2-(lb.top+lb.bottom)/2)<3,labelH:Math.round(lb.height)};l.remove();return JSON.stringify(r)})()"]]
