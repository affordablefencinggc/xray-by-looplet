+  let gross: number;
+  let unit: QuantityResult["unit"];
+  switch (measurement.kind) {
+    case "count":
+      measurement.items.forEach((entry) => entry.evidenceIds.forEach((id) => evidenceIds.add(id)));
+      gross = measurement.items.length;
+      unit = "ea";
+      break;
+    case "length":
