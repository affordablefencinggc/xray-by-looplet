+        : null;
+  const calibrations = calibrationId
+    ? [job.calibrations.find((entry) => entry.id === calibrationId)!]
+    : [];
+  calibrations.forEach((entry) => entry.evidenceIds.forEach((id) => evidenceIds.add(id)));
