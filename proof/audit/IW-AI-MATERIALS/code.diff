+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "type": "object",
+  "properties": {
+    "sheetTitle": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 3000
+    },
+    "scopeNote": {
+      "type": "string",
+      "minLength": 1,
+      "maxLength": 3000
+    },
+    "proposals": {
+      "maxItems": 100,
+      "type": "array",
+      "items": {
+        "type": "object",
+        "properties": {
+          "label": {
+            "type": "string",
+            "minLength": 1,
+            "maxLength": 3000
+          },
+          "tag": {
+            "anyOf": [
+              {
+                "type": "string",
+                "maxLength": 120
+              },
+              {
+                "type": "null"
+              }
+            ]
+          },
+          "category": {
+            "type": "string",
+            "minLength": 1,
+            "maxLength": 3000
+          },
+          "discipline": {
+            "type": "string",
+            "enum": [
+              "Structural",
+              "Architectural",
+              "Mechanical",
+              "Electrical",
+              "Plumbing",
+              "Fire protection",
