+      } : i),
+    };
+    inv = updateAssemblyRule(inv, rule.id, rule.childQuotas.map((q) => ({
+      ...q, unresolvedFields: ["torque", "washer-grade"],
+    })), "Engineer");
+    assert.deepEqual(inv.instances.find((i) => i.id === bolt.id)!.unresolvedProperties.sort(),
+      ["site-check", "torque", "washer-grade"].sort());
+    inv = updateAssemblyRule(inv, rule.id, rule.childQuotas, "Engineer");
+    const after = inv.instances.find((i) => i.id === bolt.id)!;
+    assert.deepEqual(after.unresolvedProperties, ["site-check"]);
+    assert.equal(queryInventory(inv).unresolvedCount, 1);
+    assert.equal(after.displayMark, "Custom north bolt");
+    assert.deepEqual(after.evidenceIds, bolt.evidenceIds);
+  });
+
+  it("advances materially changed components and marks their previous review stale without losing annotations", () => {
+    let inv = createSampleStructuralInventory();
+    const rule = inv.assemblyRules[0];
+    const bolt = inv.instances.find((i) => i.parentAssemblyInstanceId !== null)!;
+    const review = { status: "verified" as const, reviewedBy: "Original reviewer", reviewedAt: "2026-09-06T00:00:00.000Z", note: "M20 approved from section" };
+    inv = { ...inv, instances: inv.instances.map((i) => i.id === bolt.id ? {
+      ...i, revision: 3, displayMark: "Custom anchor", review,
+    } : i) };
+    const oldType = inv.types.find((t) => t.id === bolt.typeId)!;
+    inv = addComponentType(inv, { ...oldType, id: "fastener/m24", standardName: "M24 Bolt",
+      nominalDimensions: { ...oldType.nominalDimensions, diameter: { value: 24, unit: "mm" } } });
+    const quotas = rule.childQuotas.map((q) => ({ ...q, typeId: "fastener/m24" }));
+    inv = updateAssemblyRule(inv, rule.id, quotas, "Rule editor");
+    const after = inv.instances.find((i) => i.id === bolt.id)!;
+    assert.equal(after.typeId, "fastener/m24");
+    assert.equal(after.revision, 4);
+    assert.deepEqual(after.review, { ...review, status: "stale_revision" });
+    assert.equal(after.displayMark, "Custom anchor");
+    assert.deepEqual(after.evidenceIds, bolt.evidenceIds);
+    assert.equal(after.stableIdentifier, bolt.stableIdentifier);
+    const unchanged = updateAssemblyRule(inv, rule.id, quotas, "Rule editor");
+    assert.deepEqual(unchanged.instances.find((i) => i.id === bolt.id), after,
