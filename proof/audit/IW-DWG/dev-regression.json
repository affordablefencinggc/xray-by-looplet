  ],
  [
    "eval",
    "window.qaKey='xray:architect:v1:'+encodeURIComponent(document.querySelector('.architect-workspace').dataset.designId);window.qaBefore=JSON.parse(localStorage.getItem(qaKey));if(!document.querySelector('.arch-exchange button:nth-of-type(2)').disabled)throw Error('DWG should be native-only');'Web DWG unavailable; DXF enabled'"
  ],
  [
    "upload",
    ".arch-exchange input[type=file]",
    "C:\\Users\\danie\\repo\\xray-by-looplet\\proof\\audit\\IW-DWG\\native-roundtrip.dxf"
  ],
  [
    "wait",
    "--fn",
    "document.body.innerText.includes('Replace the current design?')"
  ],
