  ],
  [
    "wait",
    "--fn",
    "!!document.querySelector('.architect-workspace')&&document.body.innerText.includes('5 walls')"
  ],
  [
    "eval",
    "const p=JSON.parse(localStorage.getItem(qaKey));if(JSON.stringify(p.walls)!==JSON.stringify(qaBefore.walls))throw Error('Undo lost walls');if(!p.levels.some(l=>l.id===document.querySelector('[aria-label=\"Design level\"]').value))throw Error('Invalid level after undo');'Import undo restores original walls and a valid level'"
  ],
  [
    "find",
