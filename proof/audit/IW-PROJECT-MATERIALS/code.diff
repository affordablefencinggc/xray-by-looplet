+    "Text encoding",
+  ];
+  const rows = parsed.materials.map((m) => {
+    const s = m.stock,
+      t = totals.rows.find((t) => t.id === s.id)!;
+    return [
+      s.stockCode,
+      s.description,
+      m.physicalKey,
+      m.discipline,
+      m.category,
+      m.building,
+      m.floor,
+      m.location,
+      s.quantity,
+      s.unit,
+      m.quantityBasis,
+      m.calculation,
+      m.dimensionsM.length,
+      m.dimensionsM.width,
+      m.dimensionsM.height,
+      m.dimensionsM.depth,
+      m.dimensionReference,
+      m.specification,
+      t.materialVolumeM3,
+      m.volumeReference,
+      s.specifiedWeightKg,
+      s.weightBasis,
+      t.weightKg,
+      s.unitsPerPackage,
+      s.lengthM,
+      s.widthM,
+      s.heightM,
+      t.packageCount,
+      t.volumeM3,
+      m.unresolved,
+      s.reference,
+      [...new Set(m.evidence.map((e) => e.sha256))].join("; "),
+      m.evidence.map((e) => e.sha256 + ": page " + e.page + " (" + e.reference + ")").join("; "),
+      m.review,
+      m.reviewNote,
+      s.revision,
+      parsed.projectId,
+      "Preliminary; whole-project coverage requires reconciliation",
+      "xray-apostrophe/v1",
+    ];
+  });
+  return "\uFEFF" + [headers, ...rows].map((r) => r.map(cell).join(",")).join("\r\n") + "\r\n";
+}
