+                ...(p.map((v, k) => v - roof.positions[j + k]) as [number, number, number]),
+              ) < 0.00005,
+          ),
+          `${id}: facade vertex does not meet roof`,
+        );
+      }
+    }
+  } finally {
+    for (const m of meshes) m.geometry.dispose();
+    mat.dispose();
+  }
