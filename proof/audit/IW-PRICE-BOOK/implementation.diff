diff --git a/src/studio/pricing/priceBooks.css b/src/studio/pricing/priceBooks.css
new file mode 100644
index 0000000..1662e7b
--- /dev/null
+++ b/src/studio/pricing/priceBooks.css
@@ -0,0 +1,30 @@
+.price-books { --price-gap: 16px; --price-small-gap: 8px; display: grid; gap: var(--price-gap); padding: 20px; color: var(--color-ink); }
+.price-books header { display: flex; flex-wrap: wrap; gap: var(--price-gap); align-items: start; justify-content: space-between; }
+.price-books h2 { font-size: 20px; font-weight: 600; }
+.price-books h3 { font-size: 15px; font-weight: 600; }
+.price-books p { line-height: 1.5; overflow-wrap: anywhere; }
+.price-help { font-size: 12px; color: var(--color-muted); }
+.price-books label { display: grid; gap: 6px; font-size: 12px; min-width: 0; }
+.price-books input:not([type=file]), .price-books select { min-height: 44px; width: 100%; min-width: 0; padding: 8px 12px; border: 1px solid var(--color-line); border-radius: 6px; background: var(--color-bg); color: var(--color-ink); }
+.price-books input:focus-visible, .price-books select:focus-visible, .price-books button:focus-visible, .price-books summary:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }
+.price-books .pill { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; white-space: normal; }
+.price-books button:disabled { opacity: .5; cursor: not-allowed; }
+.price-books [aria-pressed=true], .price-books .primary { background: var(--color-navy); color: var(--color-on-navy); }
+.price-tabs, .price-actions, .price-toolbar { display: flex; flex-wrap: wrap; gap: var(--price-small-gap); align-items: end; }
+.price-toolbar label { flex: 1 1 220px; }
+.price-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--price-gap); }
+.price-wide { grid-column: 1 / -1; }
+.price-books fieldset { border: 1px solid var(--color-line); padding: var(--price-gap); border-radius: 8px; }
+.price-books legend { padding: 0 8px; font-weight: 600; font-size: 12px; }
+.price-notice, .price-review, .price-empty { padding: var(--price-gap); display: grid; gap: var(--price-small-gap); border: 1px solid var(--color-line); border-radius: 8px; background: var(--color-header); color: var(--color-ink); }
+.price-notice ul { padding-left: 20px; list-style: disc; font-size: 12px; }
+.price-table-wrap { max-width: 100%; overflow: auto; border: 1px solid var(--color-line); }
+.price-books table { width: 100%; border-collapse: collapse; font-size: 12px; text-align: left; }
+.price-books th, .price-books td { padding: 8px 12px; border-bottom: 1px solid var(--color-line); vertical-align: top; overflow-wrap: anywhere; }
+.price-books th { background: var(--color-header); color: var(--color-ink); font-weight: 600; }
+.price-book-card { display: grid; gap: var(--price-small-gap); padding-block: var(--price-gap); border-top: 1px solid var(--color-line); min-width: 0; }
+.price-books details { display: grid; gap: var(--price-small-gap); }
+.price-books summary { cursor: pointer; min-height: 44px; align-content: center; font-size: 12px; font-weight: 600; }
+.price-books details > :not(summary) { margin-top: var(--price-small-gap); }
+.price-amount { font-size: 16px; font-weight: 600; font-variant-numeric: tabular-nums; }
+@media (max-width: 600px) { .price-books { padding: 12px; } .price-fields { grid-template-columns: minmax(0, 1fr); } .price-books td, .price-books th { padding: 8px; } .price-tabs > button { flex: 1 1 100px; } }

diff --git a/src/studio/pricing/priceBooks.test.ts b/src/studio/pricing/priceBooks.test.ts
