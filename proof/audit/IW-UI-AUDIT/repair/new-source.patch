+const formats=read('formats-built-audit01');report.cases.push({ids:['UI-006','UI-007','TRACE-001','TRACE-007'],name:'pdf-crop-rotation-page-return-dxf-unavailable',status:'pass',details:formats.scenarios,evidence:base+'formats-built-audit01.json',scope:'Named actual source import, page, calibration and unavailable scenarios only.'});report.captures.push(...formats.captures);
