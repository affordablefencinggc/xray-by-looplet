+function add(run,names,overrides={}){const x=read(run);for(const c of x.cases.filter(c=>names.includes(c.name))){const d={...c,...overrides[c.name],evidence:base+run+'.json',scope:'Only the named normal UI scenario. Not blanket feature approval.'};delete d.body;report.cases.push(d);const capture=x.captures.find(s=>s.path===c.screenshot);if(capture)report.captures.push({...capture,verdict:d.status});}}
