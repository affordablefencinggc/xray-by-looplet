+++ b/src/studio/workspace-shell.css
@@ -0,0 +1,46 @@
+.workbench {
+  --workspace-space-1: 4px;
+  --workspace-space-2: 8px;
+  --workspace-space-3: 12px;
+  --workspace-space-4: 16px;
+  --workspace-control-height: 44px;
+  --workspace-console-height: 220px;
+}
+.workbench .studio-header { flex-wrap: wrap; gap: var(--workspace-space-3); }
+.workbench .studio-pane-nav { order: 3; flex: 1 0 100%; justify-content: center; gap: var(--workspace-space-2); overflow-x: auto; }
+.workbench .studio-pane-nav .pane-tab { min-height: var(--workspace-control-height); padding: var(--workspace-space-3) var(--workspace-space-4); font-size: 13px; font-weight: 600; white-space: nowrap; border-radius: 5px 5px 0 0; }
+.workbench .studio-pane-nav .pane-tab:hover { color: var(--color-ink); background: var(--color-selected); }
+.workbench .studio-header-actions { margin-left: auto; }
+.workspace-plan-switcher { min-width: 0; max-width: 440px; flex: 1 1 280px; }
+.workspace-plan-switcher label { display: flex; align-items: center; gap: var(--workspace-space-3); min-width: 0; }
+.workspace-plan-count { flex-shrink: 0; color: var(--color-muted); font: 11px var(--font-mono); }
+.workspace-plan-switcher select { min-width: 0; width: 100%; min-height: 36px; padding: var(--workspace-space-2); border: 1px solid var(--color-line); border-radius: 5px; background: var(--color-card); color: var(--color-ink); font: inherit; text-overflow: ellipsis; }
+.workspace-plan-switch-error { display: block; margin-top: var(--workspace-space-1); color: var(--color-ink); font-size: 11px; }
+.workbench .studio-main:has(> .workspace-diagnostics) { gap: 0; overflow: hidden; }
+.workspace-central-content { display: flex; flex: 1; flex-direction: column; min-width: 0; min-height: 0; gap: var(--workspace-space-3); overflow: auto; }
+.source-model-main > .workspace-central-content { overflow: hidden; }
+.workspace-diagnostics { flex: 0 0 auto; min-width: 0; max-width: 100%; color: var(--color-ink); background: var(--color-card); border-top: 1px solid var(--color-line); font-size: 11px; }
+.workspace-diagnostics-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--workspace-space-2); min-height: 36px; }
+.workspace-diagnostics [role="tablist"] { display: flex; min-width: 0; gap: var(--workspace-space-1); }
+.workspace-diagnostics button { display: inline-flex; align-items: center; justify-content: center; gap: var(--workspace-space-2); border: 0; background: transparent; color: var(--color-muted); padding: var(--workspace-space-2) var(--workspace-space-3); font: inherit; cursor: pointer; }
+.workspace-diagnostics button:disabled { opacity: .5; cursor: default; }
+.workspace-diagnostics button[aria-selected="true"] { color: var(--color-ink); box-shadow: inset 0 2px 0 currentColor; background: var(--color-selected); }
+.workspace-diagnostics button:focus-visible { outline: 2px solid var(--color-ink); outline-offset: -2px; }
+.workspace-diagnostic-count { min-width: 16px; padding-inline: var(--workspace-space-1); border-radius: 4px; background: var(--color-bg); color: var(--color-ink); font: 10px var(--font-mono); }
+.workspace-diagnostics [role="tabpanel"] { height: var(--workspace-console-height); max-height: 30vh; overflow: auto; border-top: 1px solid var(--color-line); }
+.workspace-diagnostic-tools { position: sticky; top: 0; display: flex; align-items: center; justify-content: space-between; padding-inline: var(--workspace-space-3); background: var(--color-card); color: var(--color-muted); border-bottom: 1px solid var(--color-line); }
+.workspace-diagnostic-events { list-style: none; margin: 0; padding: 0; font: 11px/1.5 var(--font-mono); }
+.workspace-diagnostic-events li { display: grid; grid-template-columns: 88px 124px minmax(0,1fr); gap: var(--workspace-space-2); padding: var(--workspace-space-2) var(--workspace-space-3); border-bottom: 1px solid var(--color-line); }
+.workspace-diagnostic-events time, .workspace-diagnostic-events li > span { color: var(--color-muted); }
+.workspace-diagnostic-events pre { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font: inherit; }
+.workspace-diagnostic-events li[data-level="error"] { border-left: 3px solid var(--color-ink); background: var(--color-selected); }
+.workspace-diagnostic-status, .workspace-diagnostic-empty { padding: var(--workspace-space-3); }
+.workspace-diagnostic-status dl { display: grid; gap: var(--workspace-space-2); margin: 0; }
+.workspace-diagnostic-status dl > div { display: grid; grid-template-columns: 84px minmax(0,1fr); gap: var(--workspace-space-2); }
+.workspace-diagnostic-status dt { color: var(--color-muted); }
+.workspace-diagnostic-status dd { margin: 0; overflow-wrap: anywhere; }
+.workspace-diagnostic-status p { margin: var(--workspace-space-3) 0 0; color: var(--color-muted); }
+.workspace-diagnostic-status .workspace-current-error { color: var(--color-ink); font-weight: 600; }
+@media (min-width: 2000px) {
+  .workbench .studio-pane-nav { order: 0; flex: 1 1 auto; }
+}
