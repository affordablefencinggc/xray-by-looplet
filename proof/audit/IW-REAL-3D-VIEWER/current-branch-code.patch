+  const storage = {
+    getItem: () => raw,
+    setItem: (_: string, v: string) => {
+      raw = v;
+    },
+  };
+  const chosen = { ...presetAppearance("gold"), opacity: 0.5 };
+  saveAppearance(storage, chosen);
+  assert.deepEqual(loadAppearance(storage), chosen);
+  raw = '{"background":"bad"}';
+  assert.equal(loadAppearance(storage).preset, "chrome");
+  assert.equal(
+    loadAppearance({
+      getItem: () => {
+        throw Error("denied");
+      },
+    }).preset,
+    "chrome",
+  );
+  assert.throws(
+    () =>
+      saveAppearance(
+        {
+          setItem: () => {
+            throw Error("quota");
+          },
+        },
+        chosen,
+      ),
+    /quota/,
+  );
+});
