diff --git a/proof/audit/IW-NEW-TOOLS-PROOF/sourceBuilding-before.css b/src/studio/sourceBuilding.css
index 722a702..39dbce4 100644
--- a/proof/audit/IW-NEW-TOOLS-PROOF/sourceBuilding-before.css
+++ b/src/studio/sourceBuilding.css
@@ -598,3 +598,96 @@
   font-weight: 700;
   padding: 0 4px;
 }
+
+@media (max-width: 900px) {
+  .studio-main.source-model-main {
+    overflow: auto;
+  }
+  .source-building {
+    height: auto;
+    min-height: 100%;
+  }
+  .building-heading {
+    flex-wrap: wrap;
+    gap: 12px;
+    padding: 16px;
+  }
+  .building-source-state {
+    max-width: none;
+  }
+  .building-workspace {
+    display: flex;
+    flex-direction: column;
+    flex: none;
+  }
+  .building-stage {
+    order: 0;
+    display: flex;
+    flex-direction: column;
+    flex: none;
+    height: 720px;
+    min-width: 0;
+  }
+  .building-visual-settings {
+    position: relative;
+    top: auto;
+    right: auto;
+    align-self: flex-end;
+    margin: 8px;
+    order: 0;
+  }
+  .building-toolbar {
+    position: relative;
+    inset: auto;
+    margin: 0 8px 8px;
+    order: 1;
+  }
+  .building-tool-group {
+    flex-wrap: wrap;
+    max-width: 100%;
+  }
+  .building-toolbar button,
+  .building-toolbar select,
+  .building-appearance-triggers button,
+  .building-svg-export button {
+    min-height: 44px;
+  }
+  .building-canvas {
+    position: relative;
+    inset: auto;
+    flex: 1;
+    min-height: 300px;
+    order: 2;
+  }
+  .building-svg-export {
+    position: relative;
+    inset: auto;
+    align-self: flex-end;
+    margin: 8px;
+    padding: 0 10px;
+    order: 3;
+  }
+  .building-canvas-note {
+    position: relative;
+    inset: auto;
+    margin: 0 8px 8px;
+    order: 4;
+  }
+  .building-inspector {
+    order: 1;
+    overflow: visible;
+    border-left: 0;
+    border-top: 1px solid var(--color-line);
+  }
+  .building-left-nav {
+    order: 2;
+    max-height: 280px;
+    border-right: 0;
+    border-top: 1px solid var(--color-line);
+  }
+  .building-left-nav button,
+  .building-part-picker select,
+  .building-part-evidence select {
+    min-height: 44px;
+  }
+}
