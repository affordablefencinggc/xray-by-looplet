[
  ["open", "http://127.0.0.1:8080/"],
  ["set", "viewport", "1440", "900"],
  ["wait", "--fn", "document.querySelector('.workbench')?.dataset.hydrationStatus==='ready'"],
  ["find", "role", "button", "click", "--name", "Model", "--exact"],
  ["wait", "--fn", "!!document.querySelector('.building-workspace')"],
  ["find", "role", "button", "click", "--name", "Crown Wharf A4 tower", "--exact"],
  ["wait", "--fn", "document.querySelector('.building-center-column')?.textContent.includes('Crown Wharf')"],
  ["find", "role", "button", "click", "--name", "Explore & Draw 3D Model", "--exact"],
  ["wait", "--fn", "!!document.querySelector('.building-canvas canvas')"],
  ["wait", "--fn", "Number(document.querySelector('.building-canvas canvas')?.dataset.frameCount) > 2"],
  ["find", "role", "button", "click", "--name", "Magic Pencil", "--exact"],
  ["wait", "--fn", "document.querySelector('.building-canvas canvas')?.dataset.drawMode === 'active'"],
  ["wait", "--fn", "!!document.querySelector('[data-testid=\"draftsman-dock\"]')"],
  ["eval", "window.__magicPencil.seek(0.08)"],
  ["wait", "--fn", "document.querySelector('.building-canvas canvas')?.dataset.drawPhase === 'datum_grid'"],
  ["screenshot", "proof/draftsman/phase1-datum-grid.png"],
  ["eval", "window.__magicPencil.seek(0.42)"],
  ["wait", "--fn", "document.querySelector('.building-canvas canvas')?.dataset.drawPhase === 'ascending_wireframe'"],
  ["screenshot", "proof/draftsman/phase2-ascending-wireframe.png"],
  ["eval", "window.__magicPencil.seek(0.75)"],
  ["wait", "--fn", "document.querySelector('.building-canvas canvas')?.dataset.drawPhase === 'ink_strengthening'"],
  ["screenshot", "proof/draftsman/phase3-technical-ink.png"],
  ["eval", "window.__magicPencil.seek(0.92)"],
  ["wait", "--fn", "document.querySelector('.building-canvas canvas')?.dataset.drawPhase === 'material_wash'"],
  ["screenshot", "proof/draftsman/phase4-material-wash.png"],
  ["eval", "window.__magicPencil.finish()"],
  ["wait", "--fn", "document.querySelector('.building-canvas canvas')?.dataset.drawPhase === 'complete'"],
  ["screenshot", "proof/draftsman/phase5-complete-solid.png"],
  ["eval", "(()=>{const dock=document.querySelector('[data-testid=\"draftsman-dock\"]');if(!dock)throw Error('Draftsman dock not found');const rect=dock.getBoundingClientRect();if(rect.bottom>window.innerHeight||rect.left<0||rect.right>window.innerWidth)throw Error('Draftsman dock clipped');const status=window.__magicPencil.getStatus();if(status.totalMeshCount!==2180)throw Error('Crown Wharf mesh count mismatch: '+status.totalMeshCount);return {status,dock:rect};})()"],
  ["errors"]
]
